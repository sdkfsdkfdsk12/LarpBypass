		closePicker = pickerPanel(sw, color, default, function(c) apply(c) end)
	end)
	cfgReg(key, function(v)
		if type(v) ~= "string" then return end
		local ok, c = pcall(Color3.fromHex, v)
		if ok and c then apply(c) end
	end)

	return {
		Set = function(c, silent) apply(c, silent) end,
		Get = function() return color end,
	}
end


