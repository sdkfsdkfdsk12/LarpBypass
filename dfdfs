-- подвкладки: кнопки в шапке страницы справа от названия
local function addSubTabs(tab, names)
	tab.subs = names
	tab.sub = names[1]
	local idx = 1

	-- справа от названия - место под кнопки
	local TITLE_W = TextService:GetTextSize(tab.title.Text, 18, Enum.Font.GothamBold, Vector2.new(400, 40)).X
	-- подпись под названием убираем, название ровно по центру с кнопками
	tab.desc.Visible = false
	tab.title.Size = UDim2.fromOffset(TITLE_W + 4, PAGE_HEAD)

	local bar = new("Frame", {
		Position = UDim2.fromOffset(TITLE_W + 16, (PAGE_HEAD - SUB_H) / 2),
		Size = UDim2.new(1, -(TITLE_W + 16) - 8, 0, SUB_H),
		BackgroundTransparency = 1,
		ZIndex = 3,
		Parent = tab.page,
	})

	-- кнопки-таблетки
	local BTN_GAP = 4
	local btns = {}
	local x = 0
	for i, nm in ipairs(names) do
		local tw = TextService:GetTextSize(nm, 12, Enum.Font.GothamMedium, Vector2.new(300, 40)).X
		local w = tw + 34 -- место под точку слева
		local b = new("TextButton", {
			Text = "",
			AutoButtonColor = false,
			BackgroundColor3 = Color3.fromRGB(90, 90, 90),
			BackgroundTransparency = i == idx and 0.35 or 1,
			Position = UDim2.fromOffset(x, 0),
			Size = UDim2.fromOffset(w, SUB_H),
			ZIndex = 3,
			Parent = bar,
		})
		round(b, 9)
		local dotF = new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0, 13, 0.5, 0),
			Size = UDim2.fromOffset(i == idx and 6 or 0, i == idx and 6 or 0),
			BackgroundColor3 = WHITE,
			BorderSizePixel = 0,
			ZIndex = 4,
			Parent = b,
		})
		circle(dotF)
		local lbl = new("TextLabel", {
			Text = nm,
			Font = Enum.Font.GothamMedium,
			TextSize = 12,
			TextColor3 = i == idx and WHITE or SUB,
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(i == idx and 22 or 12, 0),
			Size = UDim2.new(1, -22, 1, 0),
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 4,
			Parent = b,
		})
		btns[i] = { b = b, dot = dotF, lbl = lbl, w = w }
		x += w + BTN_GAP
	end

	local function paint(i, on)
		local o = btns[i]
		tween(o.b, 0.25, { BackgroundTransparency = on and 0.35 or 1 }, Enum.EasingDirection.Out, Enum.EasingStyle.Quint)
		tween(o.dot, 0.25, { Size = UDim2.fromOffset(on and 6 or 0, on and 6 or 0) }, Enum.EasingDirection.Out, Enum.EasingStyle.Back)
		tween(o.lbl, 0.25, { TextColor3 = on and WHITE or SUB, Position = UDim2.fromOffset(on and 22 or 12, 0) }, Enum.EasingDirection.Out, Enum.EasingStyle.Quint)
	end

	local function refresh(anim)
		relayout(tab)
		if anim then
			-- как при смене вкладки: блоки выезжают снизу, шторка растворяется
			tab.page.CanvasPosition = Vector2.zero
			tab.page.Position = UDim2.fromOffset(0, 14)
			tween(tab.page, 0.35, { Position = UDim2.fromOffset(0, 0) }, Enum.EasingDirection.Out, Enum.EasingStyle.Quint)
			if coverTween then coverTween:Cancel() end
			cover.BackgroundTransparency = 0
			coverTween = tween(cover, 0.3, { BackgroundTransparency = 1 })
		end
	end

	local function set(i)
		if i == idx then return end
		paint(idx, false)
		idx = i
		tab.sub = names[i]
		paint(i, true)
		refresh(true)
	end

	tab.setSub = function(nm)
		local i = table.find(names, nm)
		if i then set(i) end
	end

	for i, o in ipairs(btns) do
		bind(o.b.MouseEnter, function()
			if i ~= idx then
				tween(o.b, 0.15, { BackgroundTransparency = 0.8 })
				tween(o.lbl, 0.15, { TextColor3 = TEXT })
			end
		end)
		bind(o.b.MouseLeave, function()
			if i ~= idx then
				tween(o.b, 0.15, { BackgroundTransparency = 1 })
				tween(o.lbl, 0.15, { TextColor3 = SUB })
			end
		end)
		bind(o.b.MouseButton1Click, function() set(i) end)
	end

	relayout(tab)
end

-- делает блок раскрывающимся (вызывать сразу после addSection, до строк)
function Section:Collapsible(startOpen)
	self.collapsible = true
	self.isOpen = startOpen and true or false
	self.open = self.isOpen and 1 or 0
	self.card.ClipsDescendants = true
	local cardStroke = self.card:FindFirstChildOfClass("UIStroke")

	local hdr = new("TextButton", {
		Text = "",
		BackgroundColor3 = BG3,
		BackgroundTransparency = 1,
		AutoButtonColor = false,
		Size = UDim2.new(1, 0, 0, SEC_HEAD),
		ZIndex = 4,
		Parent = self.card,
	})

	local hint = new("TextLabel", {
		Text = self.isOpen and "hide" or "open",
		Font = Enum.Font.GothamMedium,
		TextSize = 10,
		TextColor3 = DIM,
		TextXAlignment = Enum.TextXAlignment.Right,
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -30, 0, SEC_HEAD / 2),
		Size = UDim2.fromOffset(40, 14),
		ZIndex = 5,
		Parent = self.card,
	})

	-- стрелочка вниз, при открытии переворачивается
	local arrow = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(1, -18, 0, SEC_HEAD / 2),
		Size = UDim2.fromOffset(10, 6),
		BackgroundTransparency = 1,
		Rotation = self.isOpen and 180 or 0,
		ZIndex = 5,
		Parent = self.card,
	})
	local c1 = line(arrow, 1, 1, 5, 5, 1.6)
	local c2 = line(arrow, 5, 5, 9, 1, 1.6)
	c1.ZIndex, c2.ZIndex = 5, 5

	local anim = Instance.new("NumberValue")
	anim.Value = self.open
	bind(anim.Changed, function(v)
		self.open = v
		relayout(self.tab)
	end)

	local animTween
	local function toggleOpen()
		self.isOpen = not self.isOpen
		local on = self.isOpen
		if on then
			for _, r in ipairs(self.rows) do r.Visible = true end
		end
		if animTween then animTween:Cancel() end
		animTween = tween(anim, on and 0.4 or 0.3, { Value = on and 1 or 0 }, Enum.EasingDirection.Out, Enum.EasingStyle.Quint)
		animTween.Completed:Connect(function(st)
			if st == Enum.PlaybackState.Completed and not self.isOpen then
				for _, r in ipairs(self.rows) do r.Visible = false end
			end
		end)
		tween(arrow, 0.35, { Rotation = on and 180 or 0 }, Enum.EasingDirection.Out, Enum.EasingStyle.Back)
		hint.Text = on and "hide" or "open"
		if cardStroke then
			cardStroke.Color = WHITE
			tween(cardStroke, 0.5, { Color = LINE })
		end
	end
	bind(hdr.MouseButton1Click, toggleOpen)
	self.expand = function()
		if not self.isOpen then toggleOpen() end
	end
	bind(hdr.MouseEnter, function()
		tween(c1, 0.15, { BackgroundColor3 = WHITE })
		tween(c2, 0.15, { BackgroundColor3 = WHITE })
		tween(hint, 0.15, { TextColor3 = TEXT })
	end)
	bind(hdr.MouseLeave, function()
		tween(c1, 0.15, { BackgroundColor3 = SUB })
		tween(c2, 0.15, { BackgroundColor3 = SUB })
		tween(hint, 0.15, { TextColor3 = DIM })
	end)

	relayout(self.tab)
	return self
end

---------------------------------------------------------------- авто-конфиг
-- каждый тумблер/слайдер/список запоминает значение; сохраняем через 1 сек после последнего изменения

local CFG_FILE = "peakzone_config.json"
local cfgData = {}
local cfgRegistry = {} -- { key, set } - чтобы при запуске вернуть сохранённое
local cfgLoading = true -- пока возвращаем сохранённое - без уведомлений
pcall(function()
	if isfile and isfile(CFG_FILE) then
		local d = game:GetService("HttpService"):JSONDecode(readfile(CFG_FILE))
		if type(d) == "table" then cfgData = d end
	end
end)

local cfgDirty, cfgAt = false, 0
local function cfgSet(key, v)
	-- пока строим меню и возвращаем сохранённое - ничего не перезаписываем
	if cfgLoading or cfgData[key] == v then return end
	cfgData[key] = v
	cfgDirty = true
	cfgAt = os.clock()
end
local function cfgWrite()
	cfgDirty = false
	if not writefile then return end
	pcall(function()
		writefile(CFG_FILE, game:GetService("HttpService"):JSONEncode(cfgData))
	end)
end
bind(RunService.Heartbeat, function()
	if cfgDirty and os.clock() - cfgAt > 1 then cfgWrite() end
end)

-- ключ: вкладка / блок / функция
local function cfgKey(sec, name)
	return sec.tab.label.Text .. "/" .. sec.name .. "/" .. name
end
local function cfgReg(key, set)
	table.insert(cfgRegistry, { key = key, set = set })
end

-- каждая функция = отдельная закруглённая плашка внутри блока
local ROW_HOVER = Color3.fromRGB(62, 62, 62) -- обводка при наведении
local ROW_ON = Color3.fromRGB(88, 88, 88)    -- обводка у включённой функции

function Section:_row(name, desc, height)
	local h = height or (desc and 40 or 32)

	local row = new("TextButton", {
		Text = "",
		BackgroundColor3 = BG3,
		AutoButtonColor = false,
		Position = UDim2.fromOffset(ROW_PAD, self.y),
		Size = UDim2.new(1, -ROW_PAD * 2, 0, h),
		ClipsDescendants = true,
		Parent = self.card,
	})
	round(row, 7)
	local rowStroke = outline(row)
	table.insert(self.rows, row)
	-- для поиска: строка, её место и текст
	table.insert(self.items, { row = row, y = self.y, h = h, name = name, desc = desc, key = (name .. " " .. (desc or "")):lower() })
	if self.collapsible and not self.isOpen then
		row.Visible = false -- в свёрнутом блоке строки не кликаются
	end

	self.y += h + ROW_GAP
	self.height = self.y + ROW_PAD - ROW_GAP
	relayout(self.tab)

	-- полоска слева: вырастает при наведении, у включённых остаётся
	local accent = new("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.fromOffset(2, 0),
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
		ZIndex = 2,
		Parent = row,
	})
	round(accent, 1)

	local title = new("TextLabel", {
		Text = name,
		Font = Enum.Font.GothamMedium,
		TextSize = 12,
		TextColor3 = TEXT,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(12, desc and 6 or 0),
		Size = UDim2.new(1, -150, 0, desc and 15 or h),
		Parent = row,
	})

	if desc then
		new("TextLabel", {
			Text = desc,
			Font = Enum.Font.Gotham,
			TextSize = 10,
			TextColor3 = DIM,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(12, 21),
			Size = UDim2.new(1, -150, 0, 13),
			Parent = row,
		})
	end

	local hovered, active = false, false
	local function paint()
		local lit = hovered or active
		tween(accent, 0.3, { Size = UDim2.fromOffset(2, active and h - 14 or (hovered and 12 or 0)) }, Enum.EasingDirection.Out, Enum.EasingStyle.Quint)
		tween(row, 0.15, { BackgroundColor3 = hovered and BG4 or BG3 })
		tween(title, 0.2, {
			TextColor3 = lit and WHITE or TEXT,
			Position = UDim2.fromOffset(hovered and 15 or 12, title.Position.Y.Offset),
		}, Enum.EasingDirection.Out, Enum.EasingStyle.Quint)
		tween(rowStroke, 0.2, { Color = active and ROW_ON or (hovered and ROW_HOVER or LINE) })
	end
	bind(row.MouseEnter, function() hovered = true; paint() end)
	bind(row.MouseLeave, function() hovered = false; paint() end)

	-- mark(true) - строка "включена": полоска и обводка остаются
	local function mark(on)
		active = on
		paint()
	end

	return row, title, rowStroke, mark
end

function Section:Toggle(name, desc, callback)
	local state = false
	local key = cfgKey(self, name)
	local row, _, _, mark = self:_row(name, desc)

	local track = new("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		Size = UDim2.fromOffset(34, 18),
		BackgroundColor3 = BG,
		BorderSizePixel = 0,
		Parent = row,
	})
	circle(track)
	local trackStroke = outline(track)

	-- белая заливка с градиентом, проявляется при включении
	local glow = new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Parent = track,
	})
	circle(glow)
	new("UIGradient", { Color = ColorSequence.new(Color3.fromRGB(150, 150, 150), WHITE), Parent = glow })

	local knob = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0, 9, 0.5, 0),
		Size = UDim2.fromOffset(12, 12),
		BackgroundColor3 = SUB,
		BorderSizePixel = 0,
		ZIndex = 2,
		Parent = track,
	})
	circle(knob)

	local function apply(v, silent)
		state = v
		-- в движении кружок вытягивается, потом снова круглый
		knob.Size = UDim2.fromOffset(18, 12)
		tween(knob, 0.35, {
			Position = UDim2.new(0, state and 25 or 9, 0.5, 0),
			Size = UDim2.fromOffset(12, 12),
			BackgroundColor3 = state and BG or SUB,
		}, Enum.EasingDirection.Out, Enum.EasingStyle.Quint)
		tween(glow, 0.25, { BackgroundTransparency = state and 0 or 1 })
		tween(trackStroke, 0.25, { Color = state and WHITE or LINE })
		mark(state)
		cfgSet(key, state)
		if not silent then task.spawn(callback, state) end
	end

	bind(row.MouseButton1Click, function() apply(not state) end)
	cfgReg(key, function(v)
		if type(v) == "boolean" and v ~= state then apply(v) end
	end)

	-- чтобы можно было включать/выключать из кода (бинды и т.д.)
	return {
		Set = function(v, silent) if v ~= state then apply(v, silent) end end,
		Get = function() return state end,
	}
end

