local traceId = 0
local traceTween

-- свет пробегает по всему краю вкладки, потом обводка остаётся целой
local function trace()
	traceId += 1
	local id = traceId
	if traceTween then traceTween:Cancel() end

	hlGrad.Transparency = SEQ_HALF
	hlGrad.Rotation = -90
	traceTween = tween(hlGrad, 0.5, { Rotation = 270 }, Enum.EasingDirection.InOut, Enum.EasingStyle.Sine)
	traceTween.Completed:Connect(function(state)
		if id ~= traceId or state ~= Enum.PlaybackState.Completed then return end
		hlGrad.Transparency = SEQ_FULL
		hlStroke.Transparency = 0.4
		tween(hlStroke, 0.4, { Transparency = 0.75 })
	end)
end

