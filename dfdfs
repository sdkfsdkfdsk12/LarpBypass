		local rootCf = hrp.CFrame
		for src, g in pairs(vis.parts) do
			if src.Parent then g.CFrame = fcf * rootCf:ToObjectSpace(src.CFrame) end
		end
		vis.p0.CFrame = rootCf
		vis.p1.CFrame = fcf
	end)
