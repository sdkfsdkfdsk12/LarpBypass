local function toastStyle(head)
	local h = head:lower()
	if h:find("murderer") then return Color3.fromRGB(255, 70, 70), "!" end
	if h:find("sheriff") then return Color3.fromRGB(70, 150, 255), "!" end
	if h:find(": on") then return Color3.fromRGB(110, 230, 140), "check" end
	if h:find(": off") then return Color3.fromRGB(150, 150, 158), "cross" end
	return WHITE, "i"
end

-- старые уведомления уезжают вверх, новое - внизу
