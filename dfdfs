		return leg ~= nil and leg:FindFirstChild("PZKorblox") ~= nil
	end

	local korbloxChar
	local checkAt = 0
	bind(RunService.RenderStepped, function()
		local char = player.Character
		if not char then return end
		if av.headless then setHead(char, true) end
		if av.korblox then
