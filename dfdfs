;(function()
	local bh = { on = false, mode = "Hold Space", max = 60, gain = 8 }
	local hops = 0
	local lastLand = 0
	local lastJump = 0
	local wasAir = false
	local baseFov

	local function reset()
		hops = 0
		local cam = workspace.CurrentCamera
		if baseFov and cam then tween(cam, 0.3, { FieldOfView = baseFov }) end
	end

	bind(RunService.Heartbeat, function()
		if not bh.on then return end
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if not hrp or not hum or hum.Health <= 0 then return end

		local moving = hum.MoveDirection.Magnitude > 0.1
		local want = (bh.mode == "Auto" and moving) or (bh.mode == "Hold Space" and UIS:IsKeyDown(Enum.KeyCode.Space))
		local onGround = hum.FloorMaterial ~= Enum.Material.Air
		local now = os.clock()

		if onGround then
			if wasAir then lastLand = now end
			wasAir = false
			if want and moving then
				-- приземлился и держишь - сразу следующий прыжок, счётчик растёт (раз за прыжок)
				if now - lastJump > 0.2 then
					lastJump = now
					hops += 1
					hum:ChangeState(Enum.HumanoidStateType.Jumping)
				end
			elseif now - lastLand > 0.25 or not moving then
				-- постоял на земле или остановился - разгон сбрасывается
				if hops > 0 then reset() end
			end
		else
			wasAir = true
			if moving and hops > 0 then
				-- в воздухе толкаем по направлению движения
				local speed = math.min(hum.WalkSpeed + hops * bh.gain * 0.5, bh.max)
				local dir = hum.MoveDirection.Unit
				local v = hrp.AssemblyLinearVelocity
				hrp.AssemblyLinearVelocity = Vector3.new(dir.X * speed, v.Y, dir.Z * speed)
				-- камера чуть шире на скорости
				local cam = workspace.CurrentCamera
				if cam then
					baseFov = baseFov or cam.FieldOfView
					local k = math.clamp((speed - hum.WalkSpeed) / math.max(bh.max - hum.WalkSpeed, 1), 0, 1)
					cam.FieldOfView = cam.FieldOfView + ((baseFov + 12 * k) - cam.FieldOfView) * 0.15
				end
			end
		end
	end)

	local sec = addSection(tTroll, "Bhop")
	sec:Toggle("Enable", "bunny hop - every jump makes you faster", function(on)
		bh.on = on
		if not on then reset() end
		notify("Bhop: " .. (on and "On" or "Off"), on and (bh.mode == "Auto" and "just run" or "hold space and run") or "stopped")
	end)
	sec:Segmented("Mode", { "Hold Space", "Auto" }, bh.mode, function(v) bh.mode = v end)
	sec:Slider("Max speed", 30, 150, bh.max, function(v) bh.max = v end)
	sec:Slider("Gain per hop", 2, 20, bh.gain, function(v) bh.gain = v end)
end)()

