				Transparency = 1, Size = Vector3.new(0.1, 0.1, 0.1), Parent = vis.folder,
			})
			return new("Attachment", { Parent = pt }), pt
		end
		local a0, p0 = anchorPart()
		local a1, p1 = anchorPart()
		vis.p0, vis.p1 = p0, p1
		new("Beam", {
			Attachment0 = a0, Attachment1 = a1, FaceCamera = true, LightEmission = 1, LightInfluence = 0,
			Width0 = 0.14, Width1 = 0.14, Segments = 1,
			Color = ColorSequence.new(WHITE),
			Transparency = NumberSequence.new(0.15, 0.55),
			Parent = p0,
		})
	end

	-- после возврата на место (приоритет чуть позже) - двигаем призрака в фейковую точку
	local VIS_NAME = "PeakZoneDesyncVis"
	pcall(function() RunService:UnbindFromRenderStep(VIS_NAME) end)
