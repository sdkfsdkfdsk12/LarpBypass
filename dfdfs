				end
			end

			-- контур вокруг всей цепочки: цвет нового призрака
			if d.hl then
				local on = shown and d.vis > 0.05
				d.hl.Enabled = on
				if on then
					d.hl.OutlineColor = colorAt(d, 0, now)
					d.hl.OutlineTransparency = math.clamp(baseTr + 0.1, 0, 0.9)
				end
			end

			-- диск на земле под самой старой точкой, мягко пульсирует
			if d.ring then
				local vis = (movedFar and 1 or 0) * d.vis
				d.ringVis = (d.ringVis or 0) + (vis - (d.ringVis or 0)) * fadeK
				if oldCf and d.ringVis > 0.02 then
					-- ищем пол под точкой (игроков и сами призраки не задеваем)
					rayParams.FilterDescendantsInstances = { folder, char }
					local hit = workspace:Raycast(oldCf.Position, Vector3.new(0, -8, 0), rayParams)
					local y = hit and hit.Position.Y + 0.05 or oldCf.Position.Y - 3
					local base = CFrame.new(oldCf.Position.X, y, oldCf.Position.Z) * CFrame.Angles(0, 0, math.rad(90))
					local pulse = 0.5 + 0.5 * math.sin(now * 4)
					local col = colorAt(d, 1, now)
					local s = 3.2 + pulse * 0.6
					d.ring.Size = Vector3.new(0.05, s, s)
					d.ring.CFrame = base
					d.ring.Color = col
					d.ring.Transparency = 1 - (1 - (0.55 + pulse * 0.25)) * d.ringVis
					d.disc.CFrame = base * CFrame.new(0.02, 0, 0)
					d.disc.Color = col
					d.disc.Transparency = 1 - (1 - baseTr * 0.5) * d.ringVis
				elseif d.ring.Transparency < 1 then
					d.ring.Transparency, d.disc.Transparency = 1, 1
					d.ring.CFrame, d.disc.CFrame = PARK, PARK
				end
			end
		end

		-- вышедшие игроки
		for p in pairs(data) do
			if not p.Parent then clearPlayer(p) end
		end
	end)

