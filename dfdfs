		for _, pb in ipairs(presetBtns) do
			local same = (pb.color:ToHex() == c:ToHex())
			pb.stroke.Transparency = same and 0 or 1
		end
		onChange(c)
	end
	paint()

	local dragging -- "sq" / "hue"
	local releasedAt = 0 -- когда отпустили ручку (чтобы отпускание не закрыло панель)
	local overPanel = false
	local function dragTo(pos)
		if dragging == "sq" then
			local p, sz = sq.AbsolutePosition, sq.AbsoluteSize
			sat = math.clamp((pos.X - p.X) / sz.X, 0, 1)
			v = 1 - math.clamp((pos.Y - p.Y) / sz.Y, 0, 1)
		elseif dragging == "hue" then
			local p, sz = hue.AbsolutePosition, hue.AbsoluteSize
			h = math.clamp((pos.X - p.X) / sz.X, 0, 0.999)
		end
		paint()
	end
	local function isPress(input)
		return input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch
	end
	local conns2 = {}
	local function hook(signal, fn)
		local c = signal:Connect(fn)
		table.insert(conns2, c)
		table.insert(conns, c)
	end
	hook(sq.InputBegan, function(input)
		if not isPress(input) then return end
		dragging = "sq"
		tween(sqKnobScale, 0.15, { Scale = 1.3 })
		dragTo(input.Position)
	end)
	hook(hue.InputBegan, function(input)
		if not isPress(input) then return end
		dragging = "hue"
		tween(hueKnobScale, 0.15, { Scale = 1.2 })
		dragTo(input.Position)
	end)
	hook(UIS.InputChanged, function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			dragTo(input.Position)
		end
	end)
	hook(UIS.InputEnded, function(input)
		if dragging and isPress(input) then
			dragging = nil
			releasedAt = os.clock()
			tween(sqKnobScale, 0.2, { Scale = 1 }, Enum.EasingDirection.Out, Enum.EasingStyle.Back)
			tween(hueKnobScale, 0.2, { Scale = 1 }, Enum.EasingDirection.Out, Enum.EasingStyle.Back)
		end
	end)

	local function setColor(c)
		h, sat, v = c:ToHSV()
		paint()
	end
	for _, pb in ipairs(presetBtns) do
		hook(pb.btn.MouseButton1Click, function()
			pb.scale.Scale = 0.8
			tween(pb.scale, 0.3, { Scale = 1 }, Enum.EasingDirection.Out, Enum.EasingStyle.Back)
			setColor(pb.color)
		end)
	end
	hook(hexBox.Focused, function() tween(hexStroke, 0.15, { Color = WHITE }) end)
	hook(hexBox.FocusLost, function()
		tween(hexStroke, 0.15, { Color = LINE })
		local txt = hexBox.Text:gsub("[^%x]", "")
		local ok, c = pcall(Color3.fromHex, txt)
		if ok and c and #txt == 6 then setColor(c) else paint() end
	end)

	-- открытие: вылетает из квадратика и пружинит (как окно на маке)
	tween(panel, 0.5, { Position = toPos() }, Enum.EasingDirection.Out, Enum.EasingStyle.Quint)
	tween(pScale, 0.55, { Scale = 1 }, Enum.EasingDirection.Out, Enum.EasingStyle.Back)
	tween(panel, 0.25, { GroupTransparency = 0 })

	local closing = false
	local function close(instant)
		if closing then return end
		closing = true
		if closePicker == close then closePicker = nil end
		for _, c in ipairs(conns2) do c:Disconnect() end
		if instant then
			dim:Destroy()
			panel:Destroy()
			return
		end
		-- закрытие: всасывается обратно в квадратик
		tween(dim, 0.25, { BackgroundTransparency = 1 })
		tween(panel, 0.32, { Position = fromPos() }, Enum.EasingDirection.In, Enum.EasingStyle.Quint)
		tween(pScale, 0.32, { Scale = 0.05 }, Enum.EasingDirection.In, Enum.EasingStyle.Quint)
		local t = tween(panel, 0.3, { GroupTransparency = 1 }, Enum.EasingDirection.In)
		t.Completed:Connect(function()
			dim:Destroy()
			panel:Destroy()
		end)
	end

	hook(panel.MouseEnter, function() overPanel = true end)
	hook(panel.MouseLeave, function() overPanel = false end)
	-- закрываем только кликом точно мимо панели
	hook(dim.MouseButton1Click, function()
		if overPanel or dragging or os.clock() - releasedAt < 0.3 then return end
		close()
	end)
	hook(lights[1].MouseButton1Click, function() setColor(oldColor) close() end) -- красный: отмена
	hook(lights[2].MouseButton1Click, function() close() end)                    -- жёлтый: свернуть
	hook(lights[3].MouseButton1Click, function() setColor(defaultColor) end)     -- зелёный: по умолчанию
	hook(done.MouseButton1Click, function()
		doneScale.Scale = 0.92
		tween(doneScale, 0.2, { Scale = 1 })
		close()
	end)
	return close
end


