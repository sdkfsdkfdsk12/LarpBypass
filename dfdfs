					it.assets = {}
					for i, v in ipairs(f.assets) do it.assets[i] = tonumber(v) or 0 end
				end
				if it.id then favs[favKey(it)] = it end
			end
		end
	end)

	local function saveFavs()
		if not writefile then return end
		local arr = {}
		for _, it in pairs(favs) do
			local f = { kind = it.kind, id = idStr(it.id), name = it.name }
			if it.assets then
				f.assets = {}
				for i, v in ipairs(it.assets) do f.assets[i] = idStr(v) end
			end
			table.insert(arr, f)
		end
		pcall(writefile, FAV_FILE, HttpService:JSONEncode(arr))
	end

	local function favList()
		local out = {}
		for _, f in pairs(favs) do
			local it = (f.kind == "b" and bundleById[f.id]) or (f.kind == "e" and emoteById[f.id]) or f
			table.insert(out, it)
		end
		table.sort(out, function(a, b) return a.name:lower() < b.name:lower() end)
		return out
	end

	---------------------------------------------------------------- загрузка анимаций из ассетов

	local objCache = {}
	local function loadAnims(assetId)
		if objCache[assetId] then return objCache[assetId] end
		local ok, objs = pcall(function()
			return game:GetObjects("rbxassetid://" .. idStr(assetId))
		end)
		if not ok or type(objs) ~= "table" then return {} end
		local found = {}
		for _, o in ipairs(objs) do
			local list = o:GetDescendants()
			table.insert(list, 1, o)
			for _, a in ipairs(list) do
				if a:IsA("Animation") and a.AnimationId ~= "" then
					table.insert(found, {
						slot = a.Parent and a.Parent.Name:lower() or "",
						name = a.Name,
						id = a.AnimationId,
					})
				end
			end
		end
		table.sort(found, function(x, y) return x.name < y.name end)
		objCache[assetId] = found
		return found
	end

	local slotCache = {}
	local function resolveBundle(b)
		if slotCache[b.id] then return slotCache[b.id] end
		-- известный пак - сразу
		local k = KNOWN[norm(b.name)]
		if k then
			slotCache[b.id] = knownSlots(k)
			return slotCache[b.id]
		end
		-- новый пак - достаём анимации из ассетов бандла
		local slots, any = {}, false
		for i, aid in ipairs(b.assets or {}) do
			if aid and aid ~= 0 then
				for _, a in ipairs(loadAnims(aid)) do
					local s = VALID[a.slot] and a.slot or SLOT_NAMES[i]
					slots[s] = slots[s] or {}
					table.insert(slots[s], a.id)
					any = true
				end
			end
		end
		if any then
			slotCache[b.id] = slots
			return slots
		end
	end

	---------------------------------------------------------------- применение пака к персонажу

	local original, current = nil, nil
	local refreshSelected = function() end

	local function getAnimate()
		local c = player.Character
		return c and c:FindFirstChild("Animate")
	end

	local function animsOf(folder)
		local t = {}
		for _, a in ipairs(folder:GetChildren()) do
			if a:IsA("Animation") then table.insert(t, a) end
		end
		table.sort(t, function(x, y) return x.Name < y.Name end)
		return t
	end

	local function saveOriginal(animate)
		if original then return end
		original = {}
		for _, folder in ipairs(animate:GetChildren()) do
			if VALID[folder.Name:lower()] then
				for _, a in ipairs(animsOf(folder)) do
					original[a] = a.AnimationId
				end
			end
		end
	end

	-- перезапуск Animate, чтобы новые анимации сразу подхватились
	local function restartAnimate()
		local animate, hum = getAnimate(), getHum()
		if not animate or not hum then return end
		animate.Disabled = true
		for _, tr in ipairs(hum:GetPlayingAnimationTracks()) do
			tr:Stop(0)
		end
		animate.Disabled = false
	end

	local function applySlots(slots)
		local animate = getAnimate()
		if not animate then return false end
		saveOriginal(animate)
		for _, folder in ipairs(animate:GetChildren()) do
			local ids = slots[folder.Name:lower()]
			if ids and #ids > 0 then
				for i, a in ipairs(animsOf(folder)) do
					a.AnimationId = ids[i] or ids[1]
				end
			end
		end
		restartAnimate()
		return true
	end

	-- выбранный пак живёт в конфиге: при запуске скрипта ставится сам
	local PACK_KEY = "Free anims/pack"
	local function savePack(b)
		cfgData[PACK_KEY] = b and { kind = "b", id = b.id, name = b.name, assets = b.assets } or nil
		cfgDirty, cfgAt = true, os.clock()
	end

	local function resetAnims()
		current = nil
		savePack(nil)
		if original then
			for a, id in pairs(original) do
				if a.Parent then a.AnimationId = id end
			end
			restartAnimate()
		end
		refreshSelected()
	end

	local busy = false
	local function applyBundle(b)
		if busy then return end
		busy = true
		task.spawn(function()
			if not slotCache[b.id] and not KNOWN[norm(b.name)] then
				notify("Loading", b.name)
			end
			local slots = resolveBundle(b)
			busy = false
			if not slots then
				notify("Free anims", "can't load pack (no GetObjects in executor)")
				return
			end
			local hum = getHum()
			if hum and hum.RigType == Enum.HumanoidRigType.R6 and not b.name:find("R6") then
				notify("R6 avatar", "most packs are made for R15")
			end
			if applySlots(slots) then
				current = { id = b.id, slots = slots }
				savePack(b)
				notify("Animation pack", b.name)
				refreshSelected()
			end
		end)
	end

	---------------------------------------------------------------- эмоции

	local emoteTrack
	local emoteAnim = {}

	local function stopEmote()
		if emoteTrack then
			pcall(function() emoteTrack:Stop(0.2) end)
			emoteTrack = nil
		end
	end

	local function playEmote(e)
		local hum = getHum()
		if not hum then return end
		task.spawn(function()
			local animId = emoteAnim[e.id]
			if not animId then
				local list = loadAnims(e.id)
				animId = list[1] and list[1].id
				emoteAnim[e.id] = animId
			end
			stopEmote()
			if animId then
				local anim = Instance.new("Animation")
				anim.AnimationId = animId
				local animator = hum:FindFirstChildOfClass("Animator") or hum
				local ok, tr = pcall(function() return animator:LoadAnimation(anim) end)
				if ok and tr then
					tr.Priority = Enum.AnimationPriority.Action
					tr.Looped = true
					tr:Play(0.2)
					emoteTrack = tr
					notify("Emote", e.name)
					return
				end
			end
			-- запасной вариант: встроенный вызов эмоции по id ассета
			local ok, _, tr = pcall(function() return hum:PlayEmoteAndGetAnimTrackById(e.id) end)
			if ok and tr then
				emoteTrack = tr
				notify("Emote", e.name)
			else
				notify("Free anims", "can't play: " .. e.name)
			end
		end)
	end

	-- как у настоящих эмоций: пошёл - эмоция закончилась
	bind(RunService.Heartbeat, function()
		if emoteTrack then
			local hum = getHum()
			if hum and hum.MoveDirection.Magnitude > 0.1 then stopEmote() end
		end
	end)

