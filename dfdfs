	local function myTargets()
		local list = {}
		for _, place in ipairs({ player.Character, player:FindFirstChildOfClass("Backpack") }) do
			for _, tool in ipairs(place and place:GetChildren() or {}) do
				if tool:IsA("Tool") and (tool.Name == "Knife" or tool.Name == "Gun") then
					local h = tool:FindFirstChild("Handle")
					if h and h:IsA("BasePart") then table.insert(list, { h, tool.Name, true }) end
				end
			end
		end
		local wd = workspace:FindFirstChild("WeaponDisplays")
		local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		local function mine(d)
			local o = ownerOf(d)
			if o then return o == player end
			-- крепление не нашли - свой, если висит прямо на нас
			return myRoot ~= nil and (d.Position - myRoot.Position).Magnitude < 4
		end
		if wd then
			for _, d in ipairs(wd:GetChildren()) do
				if d:IsA("BasePart") and mine(d) then
					local ty = d.Name:find("Knife") and "Knife" or (d.Name:find("Gun") and "Gun" or nil)
					if ty then table.insert(list, { d, ty, false }) end
				end
			end
		end
		return list
	end

