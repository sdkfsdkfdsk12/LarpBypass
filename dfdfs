		Size = UDim2.fromOffset(70, 20),
		ZIndex = 2,
		Parent = row,
	})

	local function apply(c, silent)
		color = c
		sw.BackgroundColor3 = c
		hexLbl.Text = "#" .. c:ToHex():upper()
		cfgSet(key, c:ToHex())
		if not silent then task.spawn(callback, c) end
	end

	bind(row.MouseEnter, function() tween(swStroke, 0.15, { Color = WHITE }) end)
	bind(row.MouseLeave, function() tween(swStroke, 0.15, { Color = LINE }) end)
