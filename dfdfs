			local v = readfile(SAVE_FILE)
			if v == "Off" or MASCOTS[v] then mascot.name = v end
		end
	end)

	local function b64decode(s)
		s = s:gsub("[^%w%+/=]", "")
		local f = (crypt and (crypt.base64decode or (crypt.base64 and crypt.base64.decode))) or base64_decode
		if f then
			local ok, r = pcall(f, s)
			if ok and type(r) == "string" and #r > 0 then return r end
		end
		-- запасной вариант на чистом Lua
		local map = {}
		local abc = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
		for i = 1, 64 do map[abc:byte(i)] = i - 1 end
		local out, n, bits, nb = {}, 0, 0, 0
		for i = 1, #s do
			local v = map[s:byte(i)]
			if v then
				bits = bits * 64 + v
				nb += 6
				if nb >= 8 then
					nb -= 8
					local p = 2 ^ nb
					n += 1
					out[n] = string.char(math.floor(bits / p) % 256)
					bits = bits % p
				end
			end
		end
		return table.concat(out)
