	local function flag(key)
		return function(v) esp[key] = v end
	end

	local sec = addSection(tVisual, "ESP", "ESP")
	sec:Toggle("Enable", "see players through walls", function(on)
		esp.on = on
		layer.Enabled = on
		if not on then hideAll() end
		notify("ESP: " .. (on and "On" or "Off"), on and "players highlighted" or "esp hidden")
	end)
