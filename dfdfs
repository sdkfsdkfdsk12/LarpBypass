	local ch2 = line(chevF, 4.5, 5, 1, 8.5, 1.5, DIM)
	ch1.ZIndex, ch2.ZIndex = 3, 3
	local function chev(on)
		tween(chevF, 0.3, { Rotation = on and 90 or 0 }, Enum.EasingDirection.Out, Enum.EasingStyle.Back)
		tween(ch1, 0.2, { BackgroundColor3 = on and WHITE or DIM })
		tween(ch2, 0.2, { BackgroundColor3 = on and WHITE or DIM })
	end

	local page = new("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 2,
		ScrollBarImageColor3 = SUB,
		CanvasSize = UDim2.new(),
		ScrollingDirection = Enum.ScrollingDirection.Y,
		ElasticBehavior = Enum.ElasticBehavior.Never,
		-- контент сужается под полосу прокрутки, а не лезет под неё
		VerticalScrollBarInset = Enum.ScrollBarInset.Always,
		ScrollBarImageTransparency = 0.4,
		ClipsDescendants = true,
		Visible = false,
		ZIndex = 1,
		Parent = pages,
	})

	local titleLbl = new("TextLabel", {
		Text = name,
		Font = Enum.Font.GothamBold,
		TextSize = 18,
		TextColor3 = WHITE,
		TextXAlignment = Enum.TextXAlignment.Left,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -8, 0, 22),
		Parent = page,
	})
	local descLbl = new("TextLabel", {
		Text = desc or "",
		Font = Enum.Font.Gotham,
		TextSize = 12,
		TextColor3 = SUB,
		TextXAlignment = Enum.TextXAlignment.Left,
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, 22),
		Size = UDim2.new(1, -8, 0, 16),
		Parent = page,
	})

	local tab = { index = index, y = y, btn = btn, label = label, icon = icon, chev = chev, page = page, sections = {}, title = titleLbl, desc = descLbl }
	table.insert(tabs, tab)

	bind(btn.MouseButton1Click, function() selectTab(tab) end)
	bind(btn.MouseEnter, function()
		if current ~= tab then
			tween(label, 0.15, { TextColor3 = TEXT })
			icon.color(TEXT, 0.15)
		end
	end)
	bind(btn.MouseLeave, function()
		if current ~= tab then
			tween(label, 0.15, { TextColor3 = SUB })
			icon.color(SUB, 0.15)
		end
	end)

	return tab
end

