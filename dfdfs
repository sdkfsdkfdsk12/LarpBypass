		nativeBusy = true
		local mchar = mhrp.Parent
		local target = mchar:FindFirstChild("UpperTorso") or mchar:FindFirstChild("Torso") or mhrp
		local v = mhrp.AssemblyLinearVelocity
		local livePing = getPing() / 1000
		local lead = (sa.pred / 1000) -- ручной: только ползунок (0 = без упреждения)
		local aim = target.Position + Vector3.new(v.X, v.Y * 0.5, v.Z) * lead
		local cam = workspace.CurrentCamera
		local locked = UIS.MouseBehavior == Enum.MouseBehavior.LockCenter
		if locked or not mousemoveabs then
			-- курсор по центру (первое лицо / шифтлок) - на кадр поворачиваем камеру на мардера
			cam.CFrame = CFrame.lookAt(cam.CFrame.Position, aim)
			RunService.RenderStepped:Wait()
			cam.CFrame = CFrame.lookAt(cam.CFrame.Position, aim)
			pcall(function() gun:Activate() end)
		else
			-- курсор на мардера, кадр на обновление прицела, выстрел, курсор обратно
			local p = cam:WorldToViewportPoint(aim)
			local old = UIS:GetMouseLocation()
			mousemoveabs(p.X, p.Y)
			RunService.RenderStepped:Wait()
			RunService.RenderStepped:Wait()
			pcall(function() gun:Activate() end)
			RunService.RenderStepped:Wait()
			mousemoveabs(old.X, old.Y)
		end
		print(("[peak zone] native shot at %s (lead %.0fms, %s)"):format(tostring(aim), lead * 1000, locked and "camera" or "cursor"))
		-- попал или нет
		local mhum = mchar:FindFirstChildOfClass("Humanoid")
		if mhum then
			task.spawn(function()
				local t = os.clock()
				while os.clock() - t < 1.2 do
					if mhum.Health <= 0 or not mhum.Parent then notify("Silent Aimbot", "hit") return end
					RunService.Heartbeat:Wait()
				end
				notify("Silent Aimbot", "miss")
			end)
		end
		task.delay(0.15, function() nativeBusy = false end)
	end
	bind(UIS.InputBegan, function(input, gpe)
		if gpe or not sa.on or sa.mode ~= "Native" then return end
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
		local char = player.Character
		if char and char:FindFirstChild("Gun") then task.spawn(nativeShot) end
	end)

	-- Module: подменяем WeaponService:GetMouseTargetCFrame (им родной GunClient берёт цель).
	-- хуков нет - просто меняем функцию в таблице модуля. стреляет сам пистолет игры,
	-- из своей точки и в своём формате, только цель - мардер
	;(function()
		local ok, ws = pcall(function()
			return require(game:GetService("ReplicatedStorage"):WaitForChild("ClientServices", 5):WaitForChild("WeaponService", 5))
		end)
		if not ok or type(ws) ~= "table" then return end
		local oldMouse, oldTouch = ws.GetMouseTargetCFrame, ws.GetTargetPosition
		if type(oldMouse) ~= "function" then return end

		local function aimFor(mhrp)
			local mchar = mhrp.Parent
			if isDesynced(Players:GetPlayerFromCharacter(mchar)) then return mhrp.Position end
			local target = mhrp
			if sa.part == "Head" then target = mchar:FindFirstChild("Head") or mhrp
			else target = mchar:FindFirstChild("UpperTorso") or mchar:FindFirstChild("Torso") or mhrp end
			local v = mhrp.AssemblyLinearVelocity
			local lead = (sa.pred / 1000)
			return target.Position + Vector3.new(v.X, v.Y * 0.5, v.Z) * lead
		end

		local function watchHit(mchar, through)
			local mhum = mchar and mchar:FindFirstChildOfClass("Humanoid")
			if not mhum then return end
			task.spawn(function()
				local t = os.clock()
				while os.clock() - t < 1.2 do
					if mhum.Health <= 0 or not mhum.Parent then
						if through then wbResult(true) end
						notify("Silent Aimbot", "hit")
						return
					end
					RunService.Heartbeat:Wait()
				end
				if through then wbResult(false) end
				notify("Silent Aimbot", sa.auto and "miss" or "miss - try changing Prediction")
			end)
		end

		-- redirect вызывает скрипт игры (GunClient) - с его правами: меню, notify и CoreGui оттуда
		-- недоступны (ошибка = пистолет не стреляет). флаги и уведомления - только через наш Heartbeat
		local guiOk, pending = true, {}
		bind(RunService.Heartbeat, function()
			guiOk = gui.Parent ~= nil
			while #pending > 0 do
				local job = table.remove(pending, 1)
				watchHit(job[1], job[2])
			end
		end)

		local function redirect(res)
			wsLastCall = os.clock()
			if not ((sa.on or os.clock() < wsForceUntil) and guiOk) or busy then return res end
			local _, mhrp = murderer()
			local char = player.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			if not mhrp or not hrp or not hum then return res end
			local a = gunAttach()
			local from0 = a and a.WorldPosition or hrp.Position
			local through = false
			if sa.wallbang and a and wallBetween(from0, mhrp.Position) then
				-- стена: персонаж стоит на месте, на один выстрел переносим только точку выстрела
				-- (GunRaycastAttachment) к мардеру - пистолет читает её сразу после нас
				through = true
				local back = a.CFrame
				a.WorldPosition = spoofPoint(mhrp, from0)
				task.defer(function()
					if a.Parent then a.CFrame = back end
				end)
			end
			local aim = aimFor(mhrp)
			table.insert(pending, { mhrp.Parent, through })
			if typeof(res) == "Vector3" then return aim end
			-- позиция - мардер, направление - от точки выстрела на него (не от курсора)
			local origin = (a and a.WorldPosition) or from0
			local dir = aim - origin
			if dir.Magnitude < 0.01 then dir = Vector3.new(0, 0, -1) end
			return CFrame.lookAt(aim, aim + dir.Unit)
		end

		-- любая ошибка в подмене - выстрел уходит как обычно, пистолет не ломаем
		local function safe(res)
			local ok, r = pcall(redirect, res)
			if ok then return r end
			return res
		end
		ws.GetMouseTargetCFrame = function(...)
			return safe(oldMouse(...))
		end
		if type(oldTouch) == "function" then
			ws.GetTargetPosition = function(...)
				return safe(oldTouch(...))
			end
		end
		sa.mode = "Module"
		table.insert(conns, { Disconnect = function()
			ws.GetMouseTargetCFrame = oldMouse
			if oldTouch then ws.GetTargetPosition = oldTouch end
		end })
	end)()

	local sec = addSection(tCombat, "Sheriff")
	sec:Toggle("Silent Aimbot", "shoot anywhere - the bullet hits the murderer", function(on)
		sa.on = on
		if not on then
			unmuteAll()
			local g = player.Character and player.Character:FindFirstChild("Gun")
			if g then g.ManualActivationOnly = false end
		end
		notify("Silent Aimbot: " .. (on and "On" or "Off"), on and "every shot goes to the murderer" or "disabled")
	end)
	local wbT = sec:Toggle("WallBang", "shots go straight through walls", function(on)
		sa.wallbang = on
		wbMiss = 0
	end)
	wbT.Set(true, true)
	local predS
	-- Auto prediction: раз в секунду Prediction = пинг + 100мс (задержка до сервера + интерполяция),
	-- ползунок двигается сам
	local function autoPred()
		local v = math.clamp(math.floor((getPing() + 100) / 10 + 0.5) * 10, 0, 700)
		sa.pred = v
		if predS then predS.Set(v, true) end
	end
	local autoT = sec:Toggle("Auto prediction", "sets Prediction from your ping every second", function(on)
		sa.auto = on
		if on then autoPred() end
	end)
	autoT.Set(true, true)
	predS = sec:Slider("Prediction", 0, 700, sa.pred, function(v) sa.pred = v end, function(v) return v .. "ms" end)
	local predAt = 0
	bind(RunService.Heartbeat, function()
		if not sa.auto or os.clock() - predAt < 1 then return end
		predAt = os.clock()
		autoPred()
	end)

	-- Auto Shoot Murderer: пистолет у тебя, ты в раунде - сам стреляет в мардера (повтор раз в 2 сек)
	local autoShoot = false
	local lastAuto = 0
	local function inLobby(pos)
		local lobby = workspace:FindFirstChild("Lobby") or workspace:FindFirstChild("RegularLobby")
		if not lobby then return false end
		local ok, cf, size = pcall(function() return lobby:GetBoundingBox() end)
		if not ok then return false end
		local rel = cf:PointToObjectSpace(pos)
		local half = size / 2 + Vector3.new(10, 30, 10)
		return math.abs(rel.X) <= half.X and math.abs(rel.Y) <= half.Y and math.abs(rel.Z) <= half.Z
	end
	bind(RunService.Heartbeat, function()
		if not autoShoot or busy or os.clock() - lastAuto < 2 then return end
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if not hrp or not hum or hum.Health <= 0 or inLobby(hrp.Position) then return end
		if not hasTool(player, "Gun") or not murderer() then return end
		lastAuto = os.clock()
		task.spawn(shootMurderer, false)
	end)
	sec:Toggle("Auto Shoot Murderer", "you have the gun - the murderer gets shot", function(on)
		autoShoot = on
		lastAuto = 0
		notify("Auto Shoot: " .. (on and "On" or "Off"), on and "waiting for the gun" or "disabled")
	end)
	sec:Button("Shoot Murderer", "take out the gun and fire", function()
		shootMurderer(true)
	end)
end)()

---------------------------------------------------------------- вкладка Combat: Defense (Anti Kill All)
-- мардер достал нож (или прыгает телепортами) - включаем десинк заранее: сервер видит нас
-- в случайной точке, которая меняется каждые 30 мс, чужой Kill All бьёт в пустоту.
-- у себя на экране всё как обычно, играешь сам
;(function()
	local on = false
	local lastPos = {}
	local dangerUntil = 0
	local TP_DIST = 25
	local warned = false
	local mode = "V2" -- V1: уносим персонажа в воздух; V2: десинк (играешь как обычно)
	local home, camType

	local function restore(hrp, hum)
		if hrp and hrp.Parent and home then
			hrp.CFrame = home
			hrp.AssemblyLinearVelocity = Vector3.zero
		end
		if home then dsEnd() end
		home = nil
		local cam = workspace.CurrentCamera
		cam.CameraType = camType or Enum.CameraType.Custom
		if hum then cam.CameraSubject = hum end
	end

	local function hasTool(p, name)
		local char, bp = p.Character, p:FindFirstChildOfClass("Backpack")
		return (char and char:FindFirstChild(name)) or (bp and bp:FindFirstChild(name))
	end

	local function inLobby(pos)
		local lobby = workspace:FindFirstChild("Lobby") or workspace:FindFirstChild("RegularLobby")
		if not lobby then return false end
		local ok, cf, size = pcall(function() return lobby:GetBoundingBox() end)
		if not ok then return false end
		local rel = cf:PointToObjectSpace(pos)
		local half = size / 2 + Vector3.new(10, 30, 10)
		return math.abs(rel.X) <= half.X and math.abs(rel.Y) <= half.Y and math.abs(rel.Z) <= half.Z
	end

	bind(RunService.Heartbeat, function()
		if not on then
			if DS.force then DS.force = false end
			DS.v2 = false
			if home then
				local c = player.Character
				restore(c and c:FindFirstChild("HumanoidRootPart"), c and c:FindFirstChildOfClass("Humanoid"))
			end
			return
		end
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local now = os.clock()
		-- мы мардер / мертвы / в лобби / целимся из пистолета - защита не нужна
		if not hrp or not hum or hum.Health <= 0 or hasTool(player, "Knife") or inLobby(hrp.Position)
			or char:FindFirstChild("Gun") then
			DS.force = false
			DS.v2 = false
			warned = false
			if home then restore(hrp, hum) end
			return
		end
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= player then
				local c = p.Character
				local mh = c and c:FindFirstChild("HumanoidRootPart")
				if mh and hasTool(p, "Knife") then
					local pos = mh.Position
					-- нож в руке И рядом с нами (ближе 20) - реальная угроза; нож где-то далеко - не считаем
					if c:FindFirstChild("Knife") and (pos - hrp.Position).Magnitude < 20 then
						dangerUntil = math.max(dangerUntil, now + 0.8)
					end
					-- телепорт мардера
					local prev = lastPos[p]
					if prev and (pos - prev).Magnitude > TP_DIST and not inLobby(prev) and not inLobby(pos) then
						dangerUntil = now + 2
					end
					lastPos[p] = pos
				else
					lastPos[p] = nil
				end
			end
		end
		local danger = now < dangerUntil
		if mode == "V1" and danger and not warned then
			warned = true
			notify("Anti Kill All", "murderer is coming - you're untouchable")
		elseif not danger then
			warned = false
		end
		if mode == "V2" then
			-- V2: защита всё время раунда (не ждём угрозы); десинк ставит нас каждый кадр
			-- в новую точку подальше от мардера
			local mp
			for _, p in ipairs(Players:GetPlayers()) do
				if p ~= player and hasTool(p, "Knife") and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
					mp = p.Character.HumanoidRootPart.Position
				end
			end
			DS.murdererPos = mp
			DS.force = true
			DS.v2 = true
			return
		end
		DS.v2 = false
		-- V1: уносим персонажа высоко вверх, каждый кадр новая точка; камера стоит на месте
		DS.force = false
		if danger then
			if not home then
				dsBegin(hrp)
				home = hrp.CFrame
				local cam = workspace.CurrentCamera
				camType = cam.CameraType
				cam.CameraType = Enum.CameraType.Scriptable
			end
			local r = 30
			hrp.CFrame = CFrame.new(home.Position + Vector3.new(math.random(-r, r), math.random(60, 90), math.random(-r, r)))
			hrp.AssemblyLinearVelocity = Vector3.zero
		elseif home then
			restore(hrp, hum)
		end
	end)

	local sec = addSection(tCombat, "Defense")
	sec:Toggle("Anti Kill All", "peak zone protection", function(v)
		on = v
		if not v then DS.force = false end
		notify("Anti Kill All: " .. (v and "On" or "Off"), v and "watching the murderer" or "disabled")
	end)
	sec:Segmented("Mode", { "V1", "V2" }, mode, function(v)
		mode = v
		DS.force = false
		if v ~= "V1" and home then
			local c = player.Character
			restore(c and c:FindFirstChild("HumanoidRootPart"), c and c:FindFirstChildOfClass("Humanoid"))
		end
	end)
end)()

---------------------------------------------------------------- вкладка Combat: Kill Sounds
-- убил кого-то - играет звук (отдельно для пистолета и для ножа), слышно только тебе.
-- убийство наше, если: шериф и стрелял последние 2 сек / мардер и махнул ножом или стоял рядом
;(function()
	local ks = { on = false, gun = "Headshot", knife = "MM2", volume = 70 }
	local GUN_SOUNDS = {
		Headshot = 5764885315,         -- CS:GO headshot
		Neverlose = 139452805868562,   -- neverlose.cc hitsound
		Ding = 135478009117226,        -- Minecraft bow hit ding
		Fortnite = 128045454422043,
		COD = 138832207290954,         -- Modern Warfare hitmarker
		Boom = 87026134032471,         -- BOOM HEADSHOT
	}
	local KNIFE_SOUNDS = {
		MM2 = 97347330766907,          -- MM2 knife kill
		Slash = 133948019339075,       -- heavy knife slash
		AmongUs = 7227567562,
		CSGO = 7269900245,
		TF2 = 124543461907751,
	}
	local GUN_LIST = { "Headshot", "Neverlose", "Ding", "Fortnite", "COD", "Boom" }
	local KNIFE_LIST = { "MM2", "Slash", "AmongUs", "CSGO", "TF2" }

	local function play(id)
		local snd = Instance.new("Sound")
		snd.SoundId = "rbxassetid://" .. id
		snd.Volume = ks.volume / 100 * 2
		snd.Parent = game:GetService("SoundService") -- созданный клиентом: слышно только нам, без 3D
		snd:Play()
		task.delay(4, function() snd:Destroy() end)
	end

	local function hasTool(p, name)
		local char, bp = p.Character, p:FindFirstChildOfClass("Backpack")
		return (char and char:FindFirstChild(name)) or (bp and bp:FindFirstChild(name))
	end

	-- когда последний раз стреляли / махали ножом
	local lastShot, lastStab = 0, 0
	local watched = {}
	bind(RunService.Heartbeat, function()
		local char = player.Character
		if not char then return end
		for _, name in ipairs({ "Gun", "Knife" }) do
			local tool = char:FindFirstChild(name)
			if tool and not watched[tool] then
				watched[tool] = true
				table.insert(conns, tool.Activated:Connect(function()
					if name == "Gun" then lastShot = os.clock() else lastStab = os.clock() end
				end))
				tool.AncestryChanged:Connect(function(_, parent)
					if not parent then watched[tool] = nil end
				end)
			end
		end
	end)

	-- смерти других игроков
	local alive = {}
	bind(RunService.Heartbeat, function()
		if not ks.on then return end
		local now = os.clock()
		local myChar = player.Character
		local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= player then
				local c = p.Character
				local hum = c and c:FindFirstChildOfClass("Humanoid")
				local isAlive = hum and hum.Health > 0 or false
				if alive[p] and not isAlive and hum then
					local root = c:FindFirstChild("HumanoidRootPart")
					local near = myRoot and root and (myRoot.Position - root.Position).Magnitude < 14
					if hasTool(player, "Knife") and (now - lastStab < 1.2 or near) then
						play(KNIFE_SOUNDS[ks.knife])
					elseif hasTool(player, "Gun") and now - lastShot < 2 then
						play(GUN_SOUNDS[ks.gun])
					end
				end
				alive[p] = isAlive
			end
		end
		for p in pairs(alive) do
			if not p.Parent then alive[p] = nil end
		end
	end)

	local sec = addSection(tCombat, "Kill Sounds")
	sec:Toggle("Enable", "sound when you kill someone", function(on)
		ks.on = on
		notify("Kill Sounds: " .. (on and "On" or "Off"), on and "every kill sounds good" or "silent")
	end)
	sec:Select("Gun sound", "sheriff kill", GUN_LIST, ks.gun, function(v)
		ks.gun = v
		if not cfgLoading then play(GUN_SOUNDS[v]) end
	end)
	sec:Select("Knife sound", "murderer kill", KNIFE_LIST, ks.knife, function(v)
		ks.knife = v
		if not cfgLoading then play(KNIFE_SOUNDS[v]) end
	end)
	sec:Slider("Volume", 10, 100, ks.volume, function(v) ks.volume = v end, function(v) return v .. "%" end)
	sec:Button("Test", "play the current gun and knife sounds", function()
		play(GUN_SOUNDS[ks.gun])
		task.delay(0.9, function() play(KNIFE_SOUNDS[ks.knife]) end)
	end)
end)()

---------------------------------------------------------------- вкладка Combat: Desync (фейковая позиция)
-- после физики (перед отправкой на сервер) ставим персонажа в фейковую точку,
-- перед отрисовкой возвращаем: у других ты прыгаешь по карте, у тебя всё как обычно
;(function()
	local ds = { on = false, mode = "Random", radius = 80, interval = 30, tracer = true } -- новая точка каждые ~2 кадра
	local fake -- текущая фейковая позиция (Vector3)
	local nextJump = 0
	-- настоящий CFrame хранится в DS.real (его видят граб/kill all/аимбот)
	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude

	-- случайная точка рядом, поставленная на пол
	local function pickSpot(center, char)
		rayParams.FilterDescendantsInstances = { char, workspace.CurrentCamera }
		for _ = 1, 8 do
			local a = math.random() * math.pi * 2
			local d = ds.radius * (0.4 + 0.6 * math.random())
			local p = center + Vector3.new(math.cos(a) * d, 0, math.sin(a) * d)
			local hit = workspace:Raycast(p + Vector3.new(0, 40, 0), Vector3.new(0, -120, 0), rayParams)
			if hit then return hit.Position + Vector3.new(0, 3, 0) end
		end
		return center + Vector3.new(0, 0, ds.radius)
	end

	bind(RunService.Heartbeat, function()
		if not (ds.on or DS.force) or DS.pause > 0 then return end
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if not hrp or not hum or hum.Health <= 0 then return end
		-- пистолет в руке - десинк отдыхает: сервер видит настоящую позицию, выстрелы засчитываются
		DS.gunHold = char:FindFirstChild("Gun") ~= nil
		if DS.gunHold then
			DS.fakeCF = nil
			return
		end
		local now = os.clock()
		local pos = hrp.Position

		if DS.force and DS.v2 then
			-- Anti Kill All V2: каждый кадр новая точка в объёме (радиус 100, высота ±40),
			-- из нескольких выбираем самую дальнюю от мардера, ближе 40 к нему - не берём
			local best, bestD
			for _ = 1, 6 do
				local dir = Vector3.new(math.random() * 2 - 1, (math.random() * 2 - 1) * 0.4, math.random() * 2 - 1)
				if dir.Magnitude < 0.05 then dir = Vector3.xAxis end
				local cand = pos + dir.Unit * (40 + math.random() * 60)
				local d = DS.murdererPos and (cand - DS.murdererPos).Magnitude or 999
				if d >= 40 and (not bestD or d > bestD) then best, bestD = cand, d end
			end
			fake = best or (pos + Vector3.new(0, 80, 0))
		elseif ds.mode == "Random" then
			if not fake or now >= nextJump then
				fake = pickSpot(pos, char)
				nextJump = now + ds.interval / 1000
			end
		elseif ds.mode == "Orbit" then
