		esp.roles = v
		for _, e in pairs(entries) do e.roleAt = nil end -- пересчитать сразу
	end).Set(esp.roles, true)
	sec:Select("Color", "for everyone else", { "White", "Health", "Rainbow" }, esp.color, flag("color"))
	sec:Slider("Max distance", 50, 3000, esp.dist, flag("dist"), function(v) return v .. "m" end)

	local parts = addSection(tVisual, "Elements", "ESP"):Collapsible(true)
	parts:Toggle("Chams", "glowing body through walls", flag("chams")).Set(esp.chams, true)
	parts:Toggle("Box", nil, flag("box")).Set(esp.box, true)
	parts:Segmented("Box style", { "Corners", "Full" }, esp.boxStyle, flag("boxStyle"))
	parts:Toggle("Name", nil, flag("name")).Set(esp.name, true)
	parts:Toggle("Distance", nil, flag("distance")).Set(esp.distance, true)
