					end
				else
					local e = emoteById[num] or { id = num, name = "Emote " .. idStr(num), kind = "e" }
					searchResults = { mode = "Emotes", items = { e } }
					rebuild()
					playEmote(e)
				end
			else
				info.Text = "Searching..."
				local params = CatalogSearchParams.new()
				params.SearchKeyword = text
				params.Limit = 60
				params.IncludeOffSale = true
				if m == "Emotes" then
					params.AssetTypes = { Enum.AvatarAssetType.EmoteAnimation }
				else
					params.BundleTypes = { Enum.BundleType.Animations }
				end
				local ok, pages = pcall(function() return AES:SearchCatalogAsync(params) end)
				if ok and pages then
					local items = {}
					for _, r in ipairs(pages:GetCurrentPage()) do
						if m == "Emotes" then
							table.insert(items, emoteById[r.Id] or { id = r.Id, name = r.Name, kind = "e" })
						else
							local b = bundleById[r.Id]
							if not b then
								b = { id = r.Id, name = r.Name, assets = assetsFromItems(r.BundledItems), new = false, kind = "b" }
								bundleById[r.Id] = b
							end
							table.insert(items, b)
						end
					end
					searchResults = { mode = m, items = items }
					if mode ~= m then setMode(m) end
					rebuild()
				else
					-- каталог недоступен - ищем по встроенному списку
					searchResults = nil
					filterBox.Text = text
					notify("Search", "catalog offline, filtered local list")
				end
			end
			searching = false
		end)
	end
	bind(goBtn.MouseButton1Click, doGo)
	bind(goBox.FocusLost, function(enter) if enter then doGo() end end)

	rebuild()

