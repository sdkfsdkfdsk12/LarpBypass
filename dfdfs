	end

	bind(img.MouseEnter, function() tween(hover, 0.35, { Value = 1 }, Enum.EasingDirection.Out, Enum.EasingStyle.Back) end)
	bind(img.MouseLeave, function() tween(hover, 0.3, { Value = 0 }) end)

	-- физика: "тело" маскота догоняет окно на пружинке (отстаёт, покачивается)
	local fx, fy, fvx, fvy = 0, 0, 0, 0
	local rot, rotV = 0, 0   -- наклон, тоже на пружинке
	local wvx = 0            -- сглаженная скорость окна по X
	local lastX, lastY
	local dragAmt = 0        -- 0..1, пока окно тащат

	local tc = os.clock()
	bind(RunService.RenderStepped, function(dt)
		if not img.Visible or not cur then
			lastX = nil
			return
		end
		dt = math.min(dt, 1 / 30)
		local t = os.clock() - tc
		local s = scale.Scale
		local p = peek.Value
		local hv = hover.Value
		local mp, ms = main.Position, main.Size
		local wx, wy = mp.X.Offset, mp.Y.Offset

		-- кадры гифки
		if cur.frames then
			local f = math.floor(t / cur.delay) % cur.frames
			img.ImageRectOffset = Vector2.new((f % cur.cols) * cur.cell, math.floor(f / cur.cols) * cur.cell)
		end

		if not lastX then
			-- только появился: без рывка
			fx, fy, fvx, fvy, rot, rotV, wvx = wx, wy, 0, 0, 0, 0, 0
			lastX, lastY = wx, wy
		end
		wvx += ((wx - lastX) / dt - wvx) * math.min(dt * 12, 1)
		lastX, lastY = wx, wy
		dragAmt += ((dragging and 1 or 0) - dragAmt) * math.min(dt * 8, 1)

		-- два шага на кадр, чтобы пружина не дёргалась
		local h = dt / 2
		for _ = 1, 2 do
			fvx += ((wx - fx) * 170 - fvx * 13) * h
			fvy += ((wy - fy) * 170 - fvy * 13) * h
			fx += fvx * h
			fy += fvy * h
			-- наклоняется против движения, после остановки раскачивается
			rotV += ((math.clamp(-wvx * 0.015, -22, 22) - rot) * 120 - rotV * 9) * h
			rot += rotV * h
		end
		-- стоит на надписи: вбок почти не съезжает, вниз в окно не проваливается,
		-- а если окно резко дёрнуть вниз - подлетает
		local ox = math.clamp(fx - wx, -10, 10)
		local oy = math.clamp(fy - wy, -40, 0)
		fx, fy = wx + ox, math.clamp(fy, wy - 40, wy)

		-- рывок вверх - вытягивается, вниз - сплющивается; стоя - слегка "дышит"
		local sq = math.clamp(fvy * 0.00025, -0.12, 0.12)
		local breathe = math.sin(t * 2.2) * 0.025 * (1 - dragAmt)
		local sx, sy = 1 + sq * 0.6 - breathe * 0.5, 1 - sq + breathe

		local size = SIZE * s * (1 + 0.07 * hv)
		local w, hgt = size * sx, size * sy

		-- ноги на верхнем краю букв "peak zone" (надпись: x 14, по центру полосы высотой 38)
		local left = wx - ms.X.Offset / 2 * s
		local top = wy - ms.Y.Offset / 2 * s
		local x = left + 58 * s + ox * p
		local standY = top + 13 * s
		-- p: 0 = высоко над надписью (невидим), 1 = стоит; Bounce даёт прыжки на буквах
		local y = standY - (1 - p) * 70 * s + oy * p
			- 6 * hv * s      -- наведение: привстаёт
			- 6 * dragAmt * s -- когда тащат окно - подпрыгивает

		-- наклон от ног, а не от центра картинки
		local ang = (math.sin(t * 1.6) * 2.5 * (1 - dragAmt) + rot) * math.clamp(p, 0, 1) - 4 * hv
		local r = math.rad(ang)
		x += math.sin(r) * hgt / 2
		y += (1 - math.cos(r)) * hgt / 2

		img.Position = UDim2.new(mp.X.Scale, x, mp.Y.Scale, y)
		img.Size = UDim2.fromOffset(w, hgt)
		img.Rotation = ang
		img.ImageTransparency = math.clamp(1 - p * 3, 0, 1)
	end)

	switch(mascot.name)
end)()

