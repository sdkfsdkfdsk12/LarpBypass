				if pt then pt.LocalTransparencyModifier = 0 end
			end
		end
		state.hide = nil
	end

	local function applyKorblox(char)
		restoreKorblox()
		state.char = char
		local upper = char:FindFirstChild("RightUpperLeg")
		if upper then
			state.hide = { "RightLowerLeg", "RightFoot" }
			local o = { part = upper, mesh = upper.MeshId, tex = upper.TextureID }
			local ok = pcall(function()
				upper.MeshId = K15_MESH
				upper.TextureID = K15_TEX
			end)
			if ok then
				state.orig = o
			else
				-- меш напрямую не меняется - кладём меш Korblox поверх и прячем родную ногу
				table.insert(state.hide, "RightUpperLeg")
				local over = Instance.new("Part")
				over.Name = "PZKorblox"
				over.CanCollide, over.CanQuery, over.CanTouch, over.Massless = false, false, false, true
				over.Size = upper.Size
				over.CFrame = upper.CFrame
				local m = Instance.new("SpecialMesh")
				m.MeshType = Enum.MeshType.FileMesh
				m.MeshId, m.TextureId = K15_MESH, K15_TEX
				m.Parent = over
				local w = Instance.new("WeldConstraint")
				w.Part0, w.Part1 = upper, over
				w.Parent = over
				over.Parent = char
				table.insert(state.extra, over)
			end
			return
		end
		local leg = char:FindFirstChild("Right Leg")
		if leg then
			-- R6: пакетная нога (CharacterMesh) мешает - меш задаём прямо на ногу
			for _, cm in ipairs(char:GetChildren()) do
				if cm:IsA("CharacterMesh") and cm.BodyPart == Enum.BodyPart.RightLeg then
					cm.Parent = nil
					table.insert(state.extra, { Destroy = function() cm.Parent = char end })
				end
			end
			local m = Instance.new("SpecialMesh")
			m.Name = "PZKorblox"
			m.MeshType = Enum.MeshType.FileMesh
			m.MeshId, m.TextureId = K6_MESH, K6_TEX
			m.Parent = leg
			table.insert(state.extra, m)
		end
	end

	local function setHead(char, hidden)
		local head = char and char:FindFirstChild("Head")
		if not head then return end
		head.LocalTransparencyModifier = hidden and 1 or 0
		for _, d in ipairs(head:GetChildren()) do
			if d:IsA("Decal") then d.LocalTransparencyModifier = hidden and 1 or 0 end
		end
		-- аксессуары на голове (волосы, шляпы) оставляем - как у настоящего headless
	end

