	local vis = { char = nil, folder = nil, parts = {}, a0 = nil, a1 = nil }
	local function clearVis()
		if vis.folder then vis.folder:Destroy() end
		vis.folder, vis.char = nil, nil
		table.clear(vis.parts)
	end
	local function buildVis(char)
		clearVis()
		vis.char = char
		vis.folder = new("Model", { Name = "PZDesyncGhost", Parent = workspace.CurrentCamera })
		-- призрак: копии частей тела в твоей позе
		for _, src in ipairs(char:GetChildren()) do
