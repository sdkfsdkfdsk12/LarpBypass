		local ok, res = pcall(function() return HttpService:JSONDecode(game:HttpGet(url)) end)
		if not ok or type(res) ~= "table" or type(res.data) ~= "table" then return nil end
		local list = {}
		for _, sv in ipairs(res.data) do
			if sv.id ~= game.JobId and sv.playing and sv.maxPlayers and sv.playing < sv.maxPlayers then
				table.insert(list, sv)
			end
		end
		if #list == 0 then return nil end
		if small then
