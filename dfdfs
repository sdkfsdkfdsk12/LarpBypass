-- выбор из списка: ЛКМ - следующий вариант, ПКМ - предыдущий
function Section:Select(name, desc, options, default, callback)
	local idx = table.find(options, default) or 1
	local n = #options
	local key = cfgKey(self, name)
	local row = self:_row(name, desc)

	local badge = new("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		Size = UDim2.fromOffset(130, 24),
		BackgroundColor3 = BG,
		ClipsDescendants = true,
		Parent = row,
	})
	round(badge, 6)
	local badgeStroke = outline(badge)

	-- стрелочки по краям
	local arrows = {}
	for _, dir in ipairs({ -1, 1 }) do
		local a = new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(dir < 0 and 0 or 1, dir < 0 and 10 or -10, 0.5, -1),
			Size = UDim2.fromOffset(5, 8),
			BackgroundTransparency = 1,
			ZIndex = 2,
			Parent = badge,
		})
		local l1, l2
		if dir < 0 then
			l1, l2 = line(a, 4, 0.5, 1, 4, 1.4), line(a, 1, 4, 4, 7.5, 1.4)
		else
			l1, l2 = line(a, 1, 0.5, 4, 4, 1.4), line(a, 4, 4, 1, 7.5, 1.4)
		end
		l1.ZIndex, l2.ZIndex = 2, 2
		arrows[dir] = { frame = a, l1 = l1, l2 = l2 }
	end

	-- точки снизу: какой вариант из скольких
	local dots = {}
	if n <= 8 then
		for i = 1, n do
			local d = new("Frame", {
				AnchorPoint = Vector2.new(0.5, 1),
				Position = UDim2.new(0.5, (i - (n + 1) / 2) * 6, 1, -3),
				Size = UDim2.fromOffset(i == idx and 5 or 2, 2),
				BackgroundColor3 = i == idx and WHITE or DIM,
				BorderSizePixel = 0,
				ZIndex = 2,
				Parent = badge,
			})
			circle(d)
			dots[i] = d
		end
	end

	local function makeLabel(text, yScale, transp)
		return new("TextLabel", {
			Text = text,
			Font = Enum.Font.GothamMedium,
			TextSize = 11,
			TextColor3 = TEXT,
			TextTransparency = transp,
			TextTruncate = Enum.TextTruncate.AtEnd,
			BackgroundTransparency = 1,
			Position = UDim2.new(0, 18, yScale, #dots > 0 and -2 or 0),
			Size = UDim2.new(1, -36, 1, 0),
			Parent = badge,
		})
	end

	local lbl = makeLabel(options[idx], 0, 0)
	local yOff = #dots > 0 and -2 or 0

	local function go(i, dir, silent)
		if i == idx then return end
		if dots[idx] then
			tween(dots[idx], 0.25, { Size = UDim2.fromOffset(2, 2), BackgroundColor3 = DIM })
		end
		idx = i
		if dots[idx] then
			tween(dots[idx], 0.25, { Size = UDim2.fromOffset(5, 2), BackgroundColor3 = WHITE }, Enum.EasingDirection.Out, Enum.EasingStyle.Back)
		end

		local old = lbl
		tween(old, 0.15, { Position = UDim2.new(0, 18, -dir, yOff), TextTransparency = 1 })
		task.delay(0.16, function() old:Destroy() end)
		lbl = makeLabel(options[idx], dir, 1)
		tween(lbl, 0.25, { Position = UDim2.new(0, 18, 0, yOff), TextTransparency = 0 }, Enum.EasingDirection.Out, Enum.EasingStyle.Quint)

		-- стрелка в сторону листания дёргается
		local ar = arrows[dir]
		local base = ar.frame.Position
		ar.frame.Position = base + UDim2.fromOffset(dir * 3, 0)
		tween(ar.frame, 0.3, { Position = base }, Enum.EasingDirection.Out, Enum.EasingStyle.Back)

		badgeStroke.Color = WHITE
		tween(badgeStroke, 0.4, { Color = LINE })
		cfgSet(key, options[idx])
		if not silent then task.spawn(callback, options[idx]) end
	end
	cfgReg(key, function(v)
		local i = table.find(options, v)
		if i and i ~= idx then go(i, i > idx and 1 or -1) end
	end)

	local function step(dir)
		go((idx - 1 + dir) % n + 1, dir)
	end
	bind(row.MouseButton1Click, function() step(1) end)
	bind(row.MouseButton2Click, function() step(-1) end)
	bind(row.MouseEnter, function()
		for _, ar in pairs(arrows) do
			tween(ar.l1, 0.15, { BackgroundColor3 = WHITE })
			tween(ar.l2, 0.15, { BackgroundColor3 = WHITE })
		end
	end)
	bind(row.MouseLeave, function()
		for _, ar in pairs(arrows) do
			tween(ar.l1, 0.15, { BackgroundColor3 = SUB })
			tween(ar.l2, 0.15, { BackgroundColor3 = SUB })
		end
	end)

	return {
		Set = function(opt, silent)
			local i = table.find(options, opt)
			if i then go(i, i > idx and 1 or -1, silent) end
		end,
		Get = function() return options[idx] end,
	}
end

