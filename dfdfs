		if ok and d and d.BundledItems then
			return { id = num, name = d.Name or ("Bundle " .. idStr(num)), assets = assetsFromItems(d.BundledItems), new = false, kind = "b" }
		end
		ok, d = pcall(function() return AssetService:GetBundleDetailsAsync(num) end)
		if ok and d and d.Items then
