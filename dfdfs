-- модель собирается из деталей прямо тут и крепится к частям тела (двигается с анимациями),
-- родное тело прячется; всё локально - видно только тебе
;(function()
	local cm = {
		on = false,
		target = "Self",
		model = "Toy",     -- модель из каталога
		turn = 0,          -- поворот модели, если смотрит не туда (градусы)
		fur = Color3.fromRGB(250, 248, 245),
		bow = Color3.fromRGB(255, 92, 138),
	}
	-- модели зайцев из Creator Store (бесплатные, грузятся через GetObjects)
	local MODELS = {
		Toy = 6132351260,     -- Bunny Toy
		Sugar = 13856439988,  -- Pink Sugar Bunny
		Real = 110128375015584, -- Bunny textured
	}
	local templates, loading = {}, {}
	local built = {} -- игрок -> { char, folder, ears = { {weld, base, side} }, tail, seed, parts = {} }

	-- какую модель показать на игроке: свою (Self/All) или ту, что он сам выбрал в своём скрипте
	-- (узнаём через сервер - SHARED.remote), иначе nil
	local function modelFor(p)
		if p == player then return cm.on and cm.model or nil end
		if cm.on and cm.target == "All" then return cm.model end
		local r = SHARED.remote[tostring(p.UserId)]
		if r and MODELS[r] then return r end
		return nil
	end
	-- что отправляем на сервер вместе с отметкой "в сети"
	SHARED.myModel = function() return cm.on and cm.model or "" end

	local function clear(p)
		local d = built[p]
		if not d then return end
		if d.folder then d.folder:Destroy() end
		if d.char and d.char.Parent then
			for _, x in ipairs(d.char:GetDescendants()) do
				if (x:IsA("BasePart") or x:IsA("Decal")) and not x:FindFirstAncestorOfClass("Tool") then
					x.LocalTransparencyModifier = 0
				end
			end
		end
		built[p] = nil
	end

	-- загрузить модель из каталога один раз (в фоне)
	local function getTemplate(name)
		if templates[name] ~= nil then return templates[name] or nil end
		if loading[name] then return nil end
		loading[name] = true
		task.spawn(function()
			local ok, objs = pcall(function() return game:GetObjects("rbxassetid://" .. MODELS[name]) end)
			local root = ok and objs and objs[1]
			if root and not root:IsA("Model") then
				local m = Instance.new("Model")
				for _, o in ipairs(objs) do o.Parent = m end
				root = m
			end
			if root then
				-- чистим: скрипты, звуки, лишнее
				for _, x in ipairs(root:GetDescendants()) do
					if x:IsA("LuaSourceContainer") or x:IsA("Sound") or x:IsA("ClickDetector")
						or x:IsA("ProximityPrompt") or x:IsA("Humanoid") or x:IsA("JointInstance")
						or x:IsA("WeldConstraint") or x:IsA("BillboardGui") then
						x:Destroy()
					end
				end
				if not root:FindFirstChildWhichIsA("BasePart", true) then root = nil end
			end
			templates[name] = root or false
			loading[name] = nil
			if not root then notify("Custom Models", name .. " failed to load") end
		end)
		return nil
	end

	-- модель из каталога: подгоняем по росту, ставим на уровень ног, крепим к корню
	local function buildAsset(p, char, tmpl)
		local hrp = char:FindFirstChild("HumanoidRootPart")
		local hum = char:FindFirstChildOfClass("Humanoid")
		if not hrp or not hum then return end
		local d = { char = char, parts = {}, ears = {}, seed = math.random() * 10, kind = "asset" }
		d.folder = new("Folder", { Name = "PZCustomModel", Parent = char })
		local m = tmpl:Clone()
		local parts = {}
		for _, x in ipairs(m:GetDescendants()) do
			if x:IsA("BasePart") then
				x.Name = "PZBunny"
				x.Anchored = false
				x.CanCollide = false
				x.CanQuery = false
				x.CanTouch = false
				x.Massless = true
				table.insert(parts, x)
			end
		end
		-- рост как у персонажа
		local _, size = m:GetBoundingBox()
		local height = hum.HipHeight + hrp.Size.Y / 2 + 2.6
		pcall(function() m:ScaleTo(m:GetScale() * height / math.max(size.Y, 0.1)) end)
		local bcf, bsize = m:GetBoundingBox()
		m.WorldPivot = CFrame.new(bcf.Position) * (m.WorldPivot - m.WorldPivot.Position)
		-- низ модели = уровень ног
		local feet = hum.HipHeight + hrp.Size.Y / 2
		local base = CFrame.new(0, -feet + bsize.Y / 2, 0) * CFrame.Angles(0, math.rad(cm.turn), 0)
		m:PivotTo(hrp.CFrame * base)
		-- самая большая деталь - главная, остальные к ней
		table.sort(parts, function(a, b) return a.Size.Magnitude > b.Size.Magnitude end)
		local main = parts[1]
		for i = 2, #parts do
			local wc = Instance.new("WeldConstraint")
			wc.Part0 = main
			wc.Part1 = parts[i]
			wc.Parent = parts[i]
		end
		local w = Instance.new("Weld")
		w.Part0 = hrp
		w.Part1 = main
		w.C0 = hrp.CFrame:ToObjectSpace(main.CFrame)
		w.Parent = main
		d.hop, d.hopBase = w, w.C0
		m.Parent = d.folder
		built[p] = d
		return d
	end

	local function clearAll()
		for p in pairs(built) do clear(p) end
	end

	bind(RunService.Heartbeat, function()
		if not cm.on and next(SHARED.remote) == nil and next(built) == nil then return end
		local t = os.clock()
		for _, p in ipairs(Players:GetPlayers()) do
			local char = p.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			local d = built[p]
			local name = modelFor(p)
			if not name or not char or not hum or hum.Health <= 0 then
				if d then clear(p) end
			else
				if not d or d.char ~= char or not d.folder.Parent or d.model ~= name or d.turn ~= cm.turn then
					local tmpl = getTemplate(name)
					if tmpl then
						clear(p)
						d = buildAsset(p, char, tmpl)
						if d then d.model, d.turn = name, cm.turn end
					end
				end
				if d then
					-- родное тело (кроме оружия и самой модели) прячем
					for _, x in ipairs(char:GetDescendants()) do
						if (x:IsA("BasePart") or x:IsA("Decal")) and x.Name ~= "HumanoidRootPart" and not x:IsDescendantOf(d.folder)
							and not x:FindFirstAncestorOfClass("Tool") and x.LocalTransparencyModifier < 1 then
							x.LocalTransparencyModifier = 1
						end
					end
					-- уши качаются, на бегу хлопают; хвост подпрыгивает
					local run = math.clamp(hum.MoveDirection.Magnitude, 0, 1)
					for _, e in ipairs(d.ears) do
						local sway = math.sin(t * 2.2 + d.seed + e.side) * 0.07
						local flop = math.sin(t * 11 + d.seed) * 0.22 * run
						e.weld.C0 = e.pivot * CFrame.Angles(0.12 * run + flop, 0, (-0.2 + sway) * e.side) * CFrame.new(0, 0.95, 0)
					end
					if d.tail then
						local bob = math.abs(math.sin(t * (run > 0 and 11 or 3) + d.seed)) * (0.08 + 0.12 * run)
						d.tail.C0 = d.tailBase * CFrame.new(0, bob, 0)
					end
					-- модель из каталога: прыжки на бегу, лёгкое дыхание на месте
					if d.hop then
						local hop = run > 0 and math.abs(math.sin(t * 9 + d.seed)) * 0.9 * run or math.sin(t * 2 + d.seed) * 0.05
						local tilt = run > 0 and -0.12 * run or 0
						d.hop.C0 = CFrame.new(0, hop, 0) * d.hopBase * CFrame.Angles(tilt, 0, 0)
					end
				end
			end
		end
		for p in pairs(built) do
			if not p.Parent then clear(p) end
		end
	end)

	local sec = addSection(tVisual, "Custom Models", "Models")
	sec:Toggle("Bunny", "turn into a cute bunny (peak zone users see it too)", function(on)
		cm.on = on
		if not on then clearAll() end
		notify("Bunny: " .. (on and "On" or "Off"), on and "hop hop" or "back to human")
	end)
	sec:Select("Model", "bunny model", { "Toy", "Sugar", "Real" }, cm.model, function(v)
		cm.model = v
	end)
	sec:Segmented("Target", { "Self", "All" }, cm.target, function(v)
		cm.target = v
		clearAll()
	end)
	local turnSaved = cfgData["Custom Models/turn"]
	if type(turnSaved) == "number" then cm.turn = turnSaved end
	sec:Button("Rotate model", "if it faces the wrong way", function()
		cm.turn = (cm.turn + 90) % 360
		cfgData["Custom Models/turn"] = cm.turn
		cfgDirty, cfgAt = true, os.clock()
	end)
	modelsOff = clearAll
end)()

