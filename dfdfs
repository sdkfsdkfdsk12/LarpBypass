---------------------------------------------------------------- интро

local TextService = game:GetService("TextService")

local function playIntro()
	introPlaying = true
	gui.IgnoreGuiInset = true

	local intro = new("Frame", {
		Name = "Intro",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(0, 0, 0),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = 200,
		Parent = gui,
	})

	local W = 420
	local center = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(W, 130),
		BackgroundTransparency = 1,
		Parent = intro,
	})

	-- буквы по отдельности, чтобы каждая вылетала сама
	local WORD = "PEAK ZONE"
	local FONT = Enum.Font.GothamBlack
	local SIZE = 46
	local SPACING = 4

	local widths, total = {}, 0
	for i = 1, #WORD do
		local ch = WORD:sub(i, i)
		local w = ch == " " and SIZE * 0.35 or TextService:GetTextSize(ch, SIZE, FONT, Vector2.new(200, 200)).X
		widths[i] = w
		total += w + (i < #WORD and SPACING or 0)
	end

	local left = (W - total) / 2
	local letters = {}
	local x = left
	for i = 1, #WORD do
		local ch = WORD:sub(i, i)
		if ch ~= " " then
			local holder = new("Frame", {
				Position = UDim2.fromOffset(x, 14),
				Size = UDim2.fromOffset(widths[i], 56),
				BackgroundTransparency = 1,
				Parent = center,
			})
			local lbl = new("TextLabel", {
				Text = ch,
				Font = FONT,
				TextSize = SIZE,
				TextColor3 = WHITE,
				TextTransparency = 1,
				BackgroundTransparency = 1,
				Position = UDim2.fromOffset(0, -26),
				Size = UDim2.fromScale(1, 1),
				Parent = holder,
			})
			local sc = new("UIScale", { Scale = 1.6, Parent = lbl })
			table.insert(letters, { lbl = lbl, sc = sc, i = i })
		end
		x += widths[i] + SPACING
	end

	-- полоса загрузки
	local bar = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 86),
		Size = UDim2.fromOffset(0, 2),
		BackgroundColor3 = LINE,
		BorderSizePixel = 0,
		Parent = center,
	})
	circle(bar)

	local barFill = new("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
		Parent = bar,
	})
	circle(barFill)
	local fillGrad = new("UIGradient", { Parent = barFill })

	local status = new("TextLabel", {
		Text = "",
		Font = Enum.Font.Gotham,
		TextSize = 12,
		TextColor3 = SUB,
		TextTransparency = 1,
		TextXAlignment = Enum.TextXAlignment.Left,
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(left, 96),
		Size = UDim2.fromOffset(total - 44, 16),
		Parent = center,
	})

	local percent = new("TextLabel", {
		Text = "0%",
		Font = Enum.Font.GothamMedium,
		TextSize = 12,
		TextColor3 = TEXT,
		TextTransparency = 1,
		TextXAlignment = Enum.TextXAlignment.Right,
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(left + total - 44, 96),
		Size = UDim2.fromOffset(44, 16),
		Parent = center,
	})

	-- волна ч/б по буквам + перелив полоски
	local ti = os.clock()
	local waveConn = bind(RunService.RenderStepped, function()
		local t = os.clock() - ti
		for _, L in ipairs(letters) do
			local v = 0.5 + 0.5 * math.sin(t * 3 - L.i * 0.55)
			local c = math.floor(110 + v * 145)
			L.lbl.TextColor3 = Color3.fromRGB(c, c, c)
		end
		fillGrad.Color = wave(t * 0.6)
	end)

	local progress = Instance.new("NumberValue")
	progress.Changed:Connect(function(v)
		percent.Text = math.floor(v * 100 + 0.5) .. "%"
	end)

	local OUT, IN, INOUT = Enum.EasingDirection.Out, Enum.EasingDirection.In, Enum.EasingDirection.InOut

	-- 1. затемнение и блюр
	tween(intro, 0.4, { BackgroundTransparency = 0.35 })
	tween(blur, 0.5, { Size = 24 })
	task.wait(0.3)

	-- 2. буквы падают по очереди
	for _, L in ipairs(letters) do
		tween(L.lbl, 0.55, { TextTransparency = 0, Position = UDim2.fromOffset(0, 0) }, OUT, Enum.EasingStyle.Back)
		tween(L.sc, 0.55, { Scale = 1 }, OUT, Enum.EasingStyle.Back)
		task.wait(0.06)
	end
	task.wait(0.3)

	-- 3. полоска раскрывается из центра
	tween(bar, 0.45, { Size = UDim2.fromOffset(total, 2) }, OUT, Enum.EasingStyle.Quint)
	tween(status, 0.3, { TextTransparency = 0 })
	tween(percent, 0.3, { TextTransparency = 0 })
	task.wait(0.35)

	-- 4. загрузка
	local steps = {
		{ "loading interface", 0.3 },
		{ "loading movement", 0.55 },
		{ "loading visuals", 0.8 },
		{ "done", 1 },
	}
	for _, s in ipairs(steps) do
		if not gui.Parent then break end
		status.Text = s[1]
		tween(barFill, 0.45, { Size = UDim2.fromScale(s[2], 1) }, INOUT)
		tween(progress, 0.45, { Value = s[2] }, INOUT)
		task.wait(0.5)
	end

	status.Text = "welcome, " .. player.DisplayName
	task.wait(0.6)

	-- 5. всё улетает вверх и растворяется
	for _, L in ipairs(letters) do
		tween(L.lbl, 0.35, { TextTransparency = 1, Position = UDim2.fromOffset(0, -18) }, IN)
		task.wait(0.03)
	end
	tween(status, 0.3, { TextTransparency = 1 })
	tween(percent, 0.3, { TextTransparency = 1 })
	tween(bar, 0.35, { Size = UDim2.fromOffset(0, 2) }, IN, Enum.EasingStyle.Quint)
	tween(barFill, 0.3, { BackgroundTransparency = 1 })
	tween(intro, 0.45, { BackgroundTransparency = 1 })
	task.wait(0.25)

	introPlaying = false
	if not gui.Parent then return end
	setOpen(true)

	task.wait(0.4)
	waveConn:Disconnect()
	progress:Destroy()
	intro:Destroy()
end

task.spawn(playIntro)

