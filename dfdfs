	parts:Toggle("Tracers", "lines to players", flag("tracers"))
	parts:Segmented("Tracers from", { "Bottom", "Center" }, esp.tracerFrom, flag("tracerFrom"))

	local look = addSection(tVisual, "Look", "ESP"):Collapsible(false)
	look:Slider("Chams fill", 0, 100, esp.fill, flag("fill"), function(v) return v .. "%" end)
	look:Slider("Text size", 9, 18, esp.text, flag("text"))
	look:Slider("Thickness", 1, 3, esp.thick, flag("thick"), function(v) return v .. "px" end)

	espOff = function()
		esp.on = false
		alive = false
		layer:Destroy()
	end
end)()

