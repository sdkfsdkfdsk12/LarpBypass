local conns = {}
local function bind(signal, fn)
	local c = signal:Connect(fn)
	table.insert(conns, c)
	return c
end

local function new(class, props)
	local obj = Instance.new(class)
	local parent = props.Parent
	props.Parent = nil
	for k, v in pairs(props) do
		obj[k] = v
	end
	obj.Parent = parent
	return obj
end

local function round(obj, r)
	new("UICorner", { CornerRadius = UDim.new(0, r or 6), Parent = obj })
end

local function circle(obj)
	new("UICorner", { CornerRadius = UDim.new(1, 0), Parent = obj })
end

local function outline(obj, color)
	return new("UIStroke", {
		Color = color or LINE,
		Thickness = 1,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = obj,
	})
end

local function tween(obj, t, props, dir, style)
	local tw = TweenService:Create(obj, TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end

-- переливание ч/б (синусоида, без рывков при зацикливании)
local shimmerList = {}
local function shimmer(obj)
	local g = new("UIGradient", { Parent = obj })
	table.insert(shimmerList, g)
	return g
end

local function wave(t)
	local kp = {}
	for i = 0, 8 do
		local x = i / 8
		local v = 0.5 + 0.5 * math.sin((x - t) * math.pi * 2)
		local c = math.floor(80 + v * 175)
		kp[#kp + 1] = ColorSequenceKeypoint.new(x, Color3.fromRGB(c, c, c))
	end
	return ColorSequence.new(kp)
end

---------------------------------------------------------------- иконки (рисуются фреймами, без картинок)

local function line(parent, x1, y1, x2, y2, th, color)
	local dx, dy = x2 - x1, y2 - y1
	local len = math.sqrt(dx * dx + dy * dy)
	local f = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset((x1 + x2) / 2, (y1 + y2) / 2),
		Size = UDim2.fromOffset(len + th * 0.6, th),
		Rotation = math.deg(math.atan2(dy, dx)),
		BackgroundColor3 = color or SUB,
		BorderSizePixel = 0,
		Parent = parent,
	})
	circle(f)
	return f
end

local function dot(parent, x, y, size)
	local f = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(x, y),
		Size = UDim2.fromOffset(size, size),
		BackgroundColor3 = SUB,
		BorderSizePixel = 0,
		Parent = parent,
	})
	circle(f)
	return f
end

