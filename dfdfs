---------------------------------------------------------------- вкладка Combat: Auto Grab Gun
-- шериф умер -> в карте появляется GunDrop: тп к нему, подбираем, тп обратно.
-- чтобы опережать другие скрипты: следим за шерифом и прыгаем на место его смерти
-- ещё до того, как GunDrop долетит до клиента
;(function()
	local steal = { on = false }
	local busy = false
	local latestGun -- последний появившийся GunDrop
	local sheriff = {} -- игрок -> последняя позиция, пока у него пистолет

	local function hasTool(p, name)
		local char, bp = p.Character, p:FindFirstChildOfClass("Backpack")
		return (char and char:FindFirstChild(name)) or (bp and bp:FindFirstChild(name))
	end
	local function has(name) return hasTool(player, name) end

	-- в лобби (зашёл на сервер посреди раунда / умер) - в раунде не участвуешь, не телепортируемся
	local function inLobby(pos)
		local lobby = workspace:FindFirstChild("Lobby") or workspace:FindFirstChild("RegularLobby")
		if not lobby then return false end
		local ok, cf, size = pcall(function() return lobby:GetBoundingBox() end)
		if not ok then return false end
		local rel = cf:PointToObjectSpace(pos)
		local half = size / 2 + Vector3.new(10, 30, 10)
		return math.abs(rel.X) <= half.X and math.abs(rel.Y) <= half.Y and math.abs(rel.Z) <= half.Z
	end

	local function gunPart(d)
		if d:IsA("BasePart") then return d end
		if d:IsA("Model") then return d.PrimaryPart or d:FindFirstChildWhichIsA("BasePart", true) end
	end

	local function findGun()
		if latestGun and latestGun.Parent then return latestGun end
		for _, d in ipairs(workspace:GetDescendants()) do
			if d.Name == "GunDrop" then
				local g = gunPart(d)
				if g then return g end
			end
		end
	end

	local function touch(hrp, g)
		if firetouchinterest then
			firetouchinterest(hrp, g, 0)
			firetouchinterest(hrp, g, 1)
		end
	end

	-- predict: позиция смерти шерифа - ждём там, пока появится GunDrop
	-- где мардер (у кого нож)
	local function murdererPos()
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= player and hasTool(p, "Knife") then
				local c = p.Character
				local h = c and c:FindFirstChild("HumanoidRootPart")
				if h then return h.Position end
			end
		end
	end

	local function grab(gun, manual, predict)
		if busy then return end
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if not hrp or not hum or hum.Health <= 0 then return end
		if not manual and inLobby(hrp.Position) then return end
		if has("Knife") then
			if manual then notify("Grab Gun", "murderer can't pick up the gun") end
			return
		end
		if has("Gun") then return end
		gun = gun or findGun()
		if not gun and not predict then
			if manual then notify("Grab Gun", "no dropped gun right now") end
			return
		end

		busy = true
		local t0 = os.clock()
		local function live(g) return g and g.Parent and g or nil end

		-- шериф умер, пистолета ещё нет: ждём ДОМА (не у мардера), до 1.5 сек
		while not live(gun) and os.clock() - t0 < 1.5 do
			gun = live(latestGun)
			if gun then break end
			RunService.Heartbeat:Wait()
		end
		if not live(gun) or not hrp.Parent or hum.Health <= 0 then busy = false return end

		-- мардер стоит у пистолета - ждём дома, пока отойдёт (до 3 сек); ручной граб не ждёт
		if not manual then
			local tw = os.clock()
			while os.clock() - tw < 3 do
				local mp = murdererPos()
				if not mp or not live(gun) or (mp - gun.Position).Magnitude > 8 then break end
				RunService.Heartbeat:Wait()
			end
			if not live(gun) then busy = false return end
		end

		dsBegin(hrp)
		local home = hrp.CFrame
		local got = false
		local target
		-- пистолет у нас - сразу домой, прямо в событии (без ожидания кадра)
		local function onGot(c)
			if c.Name ~= "Gun" or got then return end
			got = true
			target = nil
			if hrp.Parent and hum.Health > 0 then
				hrp.CFrame = home
				hrp.AssemblyLinearVelocity = Vector3.zero
			end
		end
		local bp = player:FindFirstChildOfClass("Backpack")
		local c1 = bp and bp.ChildAdded:Connect(onGot)
		local c2 = char.ChildAdded:Connect(onGot)
		local pre = RunService.Stepped:Connect(function()
			if target and hrp.Parent then
				hrp.CFrame = target
				hrp.AssemblyLinearVelocity = Vector3.zero
			end
		end)

		-- 1) касание прямо с места: если сервер не проверяет расстояние - никуда не летим
		touch(hrp, gun)
		RunService.Heartbeat:Wait()
		if not got and has("Gun") then got = true end

		-- 2) нет - прыжок на пистолет, касание каждый кадр, максимум 0.35 сек
		if not got then
			local tp0 = os.clock()
			while not got and os.clock() - tp0 < 0.35 do
				gun = live(gun) or live(latestGun)
				if not gun or not hrp.Parent or hum.Health <= 0 then break end
				target = gun.CFrame
				hrp.CFrame = target
				hrp.AssemblyLinearVelocity = Vector3.zero
				touch(hrp, gun)
				RunService.Heartbeat:Wait()
				if not got and has("Gun") then onGot({ Name = "Gun" }) end
			end
		end

		pre:Disconnect()
		if c1 then c1:Disconnect() end
		c2:Disconnect()
		target = nil
		if hrp.Parent and hum.Health > 0 then
			hrp.CFrame = home
			hrp.AssemblyLinearVelocity = Vector3.zero
		end
		busy = false
		dsEnd()
		if got then
			notify("Grab Gun", ("gun grabbed in %d ms"):format(math.floor((os.clock() - t0) * 1000)))
		elseif manual then
			notify("Grab Gun", "couldn't grab it")
		end
	end

	-- новый GunDrop - хватаем в тот же момент, без ожидания кадра
	bind(workspace.DescendantAdded, function(d)
		if d.Name ~= "GunDrop" then return end
		local g = gunPart(d)
		if not g then return end
		latestGun = g
		if steal.on and not busy then task.spawn(grab, g) end
	end)

	-- каждый кадр: кто шериф и где он; умер - сразу летим на его место
	bind(RunService.Heartbeat, function()
		if not steal.on then
			if next(sheriff) then table.clear(sheriff) end
			return
		end
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= player then
				local char = p.Character
				local hrp = char and char:FindFirstChild("HumanoidRootPart")
				local hum = char and char:FindFirstChildOfClass("Humanoid")
				local alive = hrp and hum and hum.Health > 0
				if alive and hasTool(p, "Gun") then
					sheriff[p] = hrp.Position
				elseif sheriff[p] then
					local pos = sheriff[p]
					sheriff[p] = nil
					-- был шерифом и именно умер (персонаж пропал в конце раунда - не считается)
					if hum and hum.Health <= 0 and not busy then
						task.spawn(grab, nil, false, pos)
					end
				end
			end
		end
		for p in pairs(sheriff) do
			if not p.Parent then sheriff[p] = nil end
		end
	end)

	local sec = addSection(tCombat, "Auto Grab Gun")
	sec:Toggle("Enable", "sheriff dies - you grab the gun instantly", function(on)
		steal.on = on
		if on then task.spawn(grab) end
		notify("Grab Gun: " .. (on and "On" or "Off"), on and "waiting for a dropped gun" or "disabled")
	end)
	sec:Button("Grab now", "take the dropped gun right now", function()
		grab(nil, true)
	end)
	if not firetouchinterest then
		sec:Button("No firetouchinterest", "executor lacks it - grab relies on teleport only", function() end)
	end
end)()

---------------------------------------------------------------- вкладка Combat: Murderer (Kill All)
-- мардер: тп за спину каждому, удар ножом + касание хендлом, пока не умрёт; потом домой
;(function()
	local auto = false
	local running = false
	local stopFlag = false
	local lastAuto = 0

	local function hasTool(p, name)
		local char, bp = p.Character, p:FindFirstChildOfClass("Backpack")
		return (char and char:FindFirstChild(name)) or (bp and bp:FindFirstChild(name))
	end

	-- игроки в лобби не в раунде - их пропускаем
	local function inLobby(pos)
		local lobby = workspace:FindFirstChild("Lobby") or workspace:FindFirstChild("RegularLobby")
		if not lobby then return false end
		local ok, cf, size = pcall(function() return lobby:GetBoundingBox() end)
		if not ok then return false end
		local rel = cf:PointToObjectSpace(pos)
		local half = size / 2 + Vector3.new(10, 30, 10)
		return math.abs(rel.X) <= half.X and math.abs(rel.Y) <= half.Y and math.abs(rel.Z) <= half.Z
	end

	local function alive(p)
		local char = p.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if hrp and hum and hum.Health > 0 then return hrp, hum, char end
	end

	-- цели: живые игроки в раунде; с пистолетом - первыми, дальше ближайшие
	local function targets(onlySheriff, from)
		local list = {}
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= player then
				local hrp = alive(p)
				if hrp and not inLobby(hrp.Position) then
					local gun = hasTool(p, "Gun") ~= nil
					if not onlySheriff or gun then
						table.insert(list, { p = p, gun = gun, d = (hrp.Position - from).Magnitude })
					end
				end
			end
		end
		table.sort(list, function(a, b)
			if a.gun ~= b.gun then return a.gun end
			return a.d < b.d
		end)
		return list
	end

	local function equipKnife(hum)
		local char = player.Character
		local knife = char and char:FindFirstChild("Knife")
		if knife then return knife end
		local bp = player:FindFirstChildOfClass("Backpack")
		knife = bp and bp:FindFirstChild("Knife")
		if knife then
			hum:EquipTool(knife)
			for _ = 1, 10 do
				if knife.Parent == char then break end
				RunService.Heartbeat:Wait()
			end
			return knife
		end
	end

	local function hit(knife, char)
		pcall(function() knife:Activate() end)
		local handle = knife:FindFirstChild("Handle")
		if handle and firetouchinterest then
			for _, n in ipairs({ "HumanoidRootPart", "UpperTorso", "Torso", "Head" }) do
				local part = char:FindFirstChild(n)
				if part then
					firetouchinterest(handle, part, 0)
					firetouchinterest(handle, part, 1)
