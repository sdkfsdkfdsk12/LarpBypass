		Size = UDim2.new(1, -60, 1, 0),
		ZIndex = 3,
		Parent = btn,
	})

	-- стрелочка справа: ">" у обычных, вниз у выбранной (как у Pulse)
	local chevF = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(1, -14, 0.5, 0),
		Size = UDim2.fromOffset(6, 10),
