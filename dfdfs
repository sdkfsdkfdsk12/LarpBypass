					if selected ~= i then break end
					-- перед ресетом ещё раз проверяем: если катка уже пошла - не убиваемся
					scanAdorned()
					active, count = voteState(i)
					if not active then
						autoStop("voting ended")
						return
					end
					if count and best and count <= best then
