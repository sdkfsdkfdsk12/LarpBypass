		local camType, camCf = cam.CameraType, cam.CFrame
		local standIn = makeStandIn(char)
		cam.CameraType = Enum.CameraType.Scriptable
		cam.CFrame = camCf

		local knife = equipKnife(hum)

		local target
		local pre = RunService.Stepped:Connect(function()
			cam.CFrame = camCf
			if hrp.Parent then
				hideReal(char, true)
				if target then
					hrp.CFrame = target
					hrp.AssemblyLinearVelocity = Vector3.zero
				end
			end
		end)

		-- круги: по кадру на каждую живую цель, пока все не умрут (максимум 2 сек)
		local left = #list
		while left > 0 and os.clock() - t0 < 2 do
			if stopFlag or hum.Health <= 0 or not hrp.Parent then break end
			left = 0
			for _, e in ipairs(list) do
				local th, _, tchar = alive(e.p)
				if th and not stopFlag then
					left += 1
					local behind = th.CFrame * CFrame.new(0, 0, 1.4)
					target = CFrame.lookAt(behind.Position, th.Position)
					hrp.CFrame = target
					hrp.AssemblyLinearVelocity = Vector3.zero
					knife = (knife and knife.Parent) and knife or equipKnife(hum)
					if knife then hit(knife, tchar) end
					RunService.Heartbeat:Wait()
					if knife then hit(knife, tchar) end
				end
			end
		end

		target = nil
		pre:Disconnect()
		if hrp.Parent and hum.Health > 0 then
			hrp.CFrame = home
			hrp.AssemblyLinearVelocity = Vector3.zero
		end
		-- ждём кадр, чтобы персонаж уже стоял дома, и возвращаем картинку
		RunService.Heartbeat:Wait()
		if char.Parent then hideReal(char, false) end
		if standIn then standIn:Destroy() end
		cam.CameraType = camType
		if hum.Parent then cam.CameraSubject = hum end

		local killed = 0
		for _, e in ipairs(list) do
			if not alive(e.p) then killed += 1 end
		end
		running = false
		dsEnd()
		notify("Kill All", ("killed %d/%d in %.2fs"):format(killed, #list, os.clock() - t0))
	end

	-- авто: стал мардером в раунде - чистим всех (раз в 2 сек, если кто-то остался)
	bind(RunService.Heartbeat, function()
		if not auto or running or os.clock() - lastAuto < 2 then return end
		local hrp = alive(player)
		if not hrp or inLobby(hrp.Position) or not hasTool(player, "Knife") then return end
