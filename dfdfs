	-- большие id (15 цифр) печатаем без экспоненты
	local function idStr(id)
		return string.format("%.0f", id)
	end

	local function norm(s)
		s = s:lower():gsub("animations?", ""):gsub("package", ""):gsub("pack", ""):gsub("[^%w]", "")
		return s
	end

