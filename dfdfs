		color = "White",     -- White / Health / Rainbow
		chams = true,        -- подсветка модели сквозь стены
		box = true,
		boxStyle = "Corners",
		name = true,
		distance = true,
		health = true,
		tracers = false,
		tracerFrom = "Bottom",
		fill = 30,           -- заливка подсветки, %
		text = 12,
		thick = 1,
	}

	-- отдельный слой под меню, на весь экран
	local layer = new("ScreenGui", {
		Name = "PeakZoneESP",
		IgnoreGuiInset = true,
		ResetOnSpawn = false,
		DisplayOrder = -2,
		Enabled = false,
		Parent = gui.Parent,
	})
	local chamsFolder = new("Folder", { Name = "Chams", Parent = layer })

	local BLACK = Color3.new(0, 0, 0)
	local MURDER = Color3.fromRGB(255, 58, 58)
	local SHERIFF = Color3.fromRGB(64, 150, 255)
	local entries = {}

	-- роль в MM2 по оружию: нож = мардер, пистолет = шериф (или подобравший пистолет)
	local function hasTool(plr, name)
		local char = plr.Character
		local bp = plr:FindFirstChildOfClass("Backpack")
		return (char and char:FindFirstChild(name) ~= nil) or (bp and bp:FindFirstChild(name) ~= nil)
	end

	-- роли от сервера: MM2 отдаёт их через GetPlayerData уже во время отсчёта, до выдачи оружия
	local serverRoles = {}
	local alive = true
	task.spawn(function()
		local rf
		while alive do
			if esp.on and esp.roles then
				if not rf or not rf.Parent then
					rf = game:GetService("ReplicatedStorage"):FindFirstChild("GetPlayerData", true)
				end
				if rf and rf:IsA("RemoteFunction") then
					local ok, data = pcall(rf.InvokeServer, rf)
					if ok and type(data) == "table" then
						local fresh = {}
						for name, d in pairs(data) do
							if type(d) == "table" and type(d.Role) == "string" and not d.Dead and not d.Killed then
								fresh[name] = d.Role
							end
						end
						serverRoles = fresh
					end
				end
			end
			task.wait(1)
		end
	end)

	local function getRole(plr)
		-- оружие в руках/рюкзаке - самый точный признак
		if hasTool(plr, "Knife") then return "Murderer" end
		if hasTool(plr, "Gun") then return "Sheriff" end
		-- иначе то, что сказал сервер (Hero = подобрал пистолет)
		local r = serverRoles[plr.Name]
		if r == "Murderer" then return "Murderer" end
		if r == "Sheriff" or r == "Hero" then return "Sheriff" end
	end

	local function piece(parent)
		local f = new("Frame", {
			BackgroundColor3 = WHITE,
			BorderSizePixel = 0,
			Parent = parent,
		})
		-- тёмный контур, чтобы было видно на любом фоне
		new("UIStroke", { Color = BLACK, Transparency = 0.5, Thickness = 1, Parent = f })
		return f
	end

	local function label(parent, anchorY)
		return new("TextLabel", {
			Font = Enum.Font.GothamBold,
			TextSize = 12,
			TextColor3 = WHITE,
			TextStrokeColor3 = BLACK,
			TextStrokeTransparency = 0.45,
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(0.5, anchorY),
			Size = UDim2.fromOffset(220, 14),
			Parent = parent,
		})
	end

	local function add(plr)
		if plr == player or entries[plr] then return end
		local e = { plr = plr, alpha = 0, hp = 1, hue = math.random() }
		e.root = new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(0, 0), Visible = false, Parent = layer })

		-- лёгкая заливка внутри рамки: снизу гуще, сверху прозрачная
		e.fill = new("Frame", { BackgroundColor3 = WHITE, BorderSizePixel = 0, Parent = e.root })
		e.fillGrad = new("UIGradient", {
			Rotation = 90,
			Transparency = NumberSequence.new(1, 0.82),
			Parent = e.fill,
		})

		e.corners = {}
		for i = 1, 8 do e.corners[i] = piece(e.root) end

		e.full = new("Frame", { BackgroundTransparency = 1, Parent = e.root })
		e.fullStroke = new("UIStroke", { Color = WHITE, Thickness = 1, Parent = e.full })
		e.fullShadow = new("Frame", { BackgroundTransparency = 1, Parent = e.root })
		new("UIStroke", { Color = BLACK, Transparency = 0.5, Thickness = 3, Parent = e.fullShadow })

		e.name = label(e.root, 1)
		e.info = label(e.root, 0)
		e.info.Font = Enum.Font.GothamMedium

		e.hpBg = new("Frame", { BackgroundColor3 = BLACK, BackgroundTransparency = 0.35, BorderSizePixel = 0, Parent = e.root })
		e.hpFill = new("Frame", {
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.new(0, 1, 1, -1),
			BackgroundColor3 = WHITE,
			BorderSizePixel = 0,
			Parent = e.hpBg,
		})

		e.tracer = piece(e.root)
		e.tracer.AnchorPoint = Vector2.new(0.5, 0.5)

		e.hl = new("Highlight", {
			DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
			Enabled = false,
			Parent = chamsFolder,
		})

		entries[plr] = e
	end

	local function remove(plr)
		local e = entries[plr]
		if not e then return end
		e.root:Destroy()
		e.hl:Destroy()
		entries[plr] = nil
	end

	for _, plr in ipairs(Players:GetPlayers()) do add(plr) end
	bind(Players.PlayerAdded, add)
	bind(Players.PlayerRemoving, remove)

	local function hpColor(r)
		-- зелёный -> жёлтый -> красный
		return Color3.fromHSV(0.33 * math.clamp(r, 0, 1), 0.8, 1)
	end

	local function setLine(f, x1, y1, x2, y2, th)
		local dx, dy = x2 - x1, y2 - y1
		f.Position = UDim2.fromOffset((x1 + x2) / 2, (y1 + y2) / 2)
		f.Size = UDim2.fromOffset(math.sqrt(dx * dx + dy * dy), th)
		f.Rotation = math.deg(math.atan2(dy, dx))
	end

	local function hideAll()
		for _, e in pairs(entries) do
			e.alpha = 0
			e.root.Visible = false
			e.hl.Enabled = false
		end
	end

	bind(RunService.RenderStepped, function(dt)
		if not esp.on then return end
		local cam = workspace.CurrentCamera
		if not cam then return end
		local vp = cam.ViewportSize
		local camPos = cam.CFrame.Position
		local now = os.clock()
		local k = math.min(dt * 10, 1)

		for plr, e in pairs(entries) do
			local char = plr.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			local show = false
			local dist = 0

			if hrp and hum and hum.Health > 0 then
				dist = (camPos - hrp.Position).Magnitude
				if dist <= esp.dist then
					local top = cam:WorldToViewportPoint(hrp.Position + Vector3.new(0, 3, 0))
					local bot = cam:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3.4, 0))
					if top.Z > 0 and bot.Z > 0 then
						local h = math.max(bot.Y - top.Y, 6)
						local w = h * 0.6
						local cx = (top.X + bot.X) / 2
						show = cx > -w and cx < vp.X + w and bot.Y > 0 and top.Y < vp.Y
						if show then
							-- запоминаем, чтобы при исчезновении рамка не прыгала
							e.x, e.y, e.w, e.h, e.d = cx, top.Y, w, h, dist
						end
					end
				end
			end

			-- плавно появляется и исчезает
			e.alpha += ((show and 1 or 0) - e.alpha) * k
			if e.alpha < 0.02 or not e.x then
				e.root.Visible = false
				e.hl.Enabled = false
				continue
			end
			e.root.Visible = true
			local a = e.alpha
			local ta = 1 - a

			local hpR = hum and hum.MaxHealth > 0 and hum.Health / hum.MaxHealth or 0
			e.hp += (hpR - e.hp) * math.min(dt * 8, 1)

			-- роль проверяем 4 раза в секунду, не каждый кадр
			if not e.roleAt or now - e.roleAt > 0.25 then
				e.roleAt = now
				local role = esp.roles and getRole(plr) or nil
				if role and role ~= e.role then
					notify(role == "Murderer" and "Murderer found" or "Sheriff found", plr.DisplayName)
				end
				e.role = role
			end

			local col = WHITE
			if e.role == "Murderer" then
				col = MURDER
			elseif e.role == "Sheriff" then
				col = SHERIFF
			elseif esp.color == "Health" then
				col = hpColor(e.hp)
			elseif esp.color == "Rainbow" then
				col = Color3.fromHSV((now * 0.15 + e.hue) % 1, 0.55, 1)
			end

			local x0, y0 = e.x - e.w / 2, e.y
			local x1, y1 = e.x + e.w / 2, e.y + e.h
			local th = esp.thick

			-- заливка
			e.fill.Visible = esp.box
			e.fill.Position = UDim2.fromOffset(x0, y0)
			e.fill.Size = UDim2.fromOffset(e.w, e.h)
			e.fill.BackgroundColor3 = col
			e.fill.BackgroundTransparency = ta

			-- уголки
			local corners = esp.box and esp.boxStyle == "Corners"
			local lw, lh = math.max(e.w * 0.28, 4), math.max(e.h * 0.2, 4)
			local P = {
				{ x0, y0, lw, th }, { x0, y0, th, lh },
				{ x1 - lw, y0, lw, th }, { x1 - th, y0, th, lh },
				{ x0, y1 - th, lw, th }, { x0, y1 - lh, th, lh },
				{ x1 - lw, y1 - th, lw, th }, { x1 - th, y1 - lh, th, lh },
			}
			for i, c in ipairs(e.corners) do
				c.Visible = corners
				if corners then
					local q = P[i]
					c.Position = UDim2.fromOffset(q[1], q[2])
					c.Size = UDim2.fromOffset(q[3], q[4])
					c.BackgroundColor3 = col
					c.BackgroundTransparency = ta
				end
			end

			-- полная рамка
			local full = esp.box and esp.boxStyle == "Full"
			e.full.Visible = full
			e.fullShadow.Visible = full
			if full then
				e.full.Position = UDim2.fromOffset(x0, y0)
				e.full.Size = UDim2.fromOffset(e.w, e.h)
				e.fullShadow.Position = e.full.Position
				e.fullShadow.Size = e.full.Size
				e.fullStroke.Color = col
				e.fullStroke.Thickness = th
				e.fullStroke.Transparency = ta
			end

			-- ник над рамкой
			e.name.Visible = esp.name
			if esp.name then
				e.name.Text = plr.DisplayName
				e.name.TextSize = esp.text
				e.name.Position = UDim2.fromOffset(e.x, y0 - 3)
				e.name.TextColor3 = col
				e.name.TextTransparency = ta
				e.name.TextStrokeTransparency = 0.45 + 0.55 * ta
			end

			-- дистанция под рамкой
			e.info.Visible = esp.distance
			if esp.distance then
				local m = math.floor(e.d + 0.5) .. "m"
				e.info.Text = e.role and (string.upper(e.role) .. "  ·  " .. m) or m
				e.info.TextSize = esp.text - 1
				e.info.Position = UDim2.fromOffset(e.x, y1 + 3)
				e.info.TextColor3 = e.role and col or SUB:Lerp(WHITE, 0.5)
				e.info.TextTransparency = ta
				e.info.TextStrokeTransparency = 0.45 + 0.55 * ta
			end

			-- полоска здоровья слева
			e.hpBg.Visible = esp.health
			if esp.health then
				e.hpBg.Position = UDim2.fromOffset(x0 - 6, y0 - 1)
				e.hpBg.Size = UDim2.fromOffset(4, e.h + 2)
				e.hpBg.BackgroundTransparency = 0.35 + 0.65 * ta
				e.hpFill.Size = UDim2.new(0, 2, math.clamp(e.hp, 0, 1), -2)
				e.hpFill.BackgroundColor3 = hpColor(e.hp)
				e.hpFill.BackgroundTransparency = ta
			end

			-- линия от низа/центра экрана до ног
			e.tracer.Visible = esp.tracers
			if esp.tracers then
				local fy = esp.tracerFrom == "Center" and vp.Y / 2 or vp.Y - 2
				setLine(e.tracer, vp.X / 2, fy, e.x, y1, th)
				e.tracer.BackgroundColor3 = col
				e.tracer.BackgroundTransparency = 0.25 + 0.75 * ta
			end

			-- подсветка модели сквозь стены
			e.hl.Enabled = esp.chams
			if esp.chams then
				e.hl.Adornee = char
				e.hl.FillColor = col
				e.hl.OutlineColor = col
				e.hl.FillTransparency = 1 - esp.fill / 100 * 0.85 * a
				e.hl.OutlineTransparency = 1 - 0.9 * a
			end
		end
	end)

