-- anti fling: чужие персонажи у нас без коллизии (толкнуть нечем)
-- + если всё же резко разогнало/закрутило - гасим скорость и возвращаем на место
local flingSaved = {} -- чужие части, у которых выключили коллизию
local safeCf, safeAt = nil, 0
local FLING_SPEED, FLING_SPIN = 200, 60
bind(RunService.Stepped, function()
	if not cfg.antiFling then return end
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player and p.Character then
			for _, part in ipairs(p.Character:GetDescendants()) do
				if part:IsA("BasePart") and part.CanCollide then
					flingSaved[part] = true
					part.CanCollide = false
				end
			end
		end
	end
end)
bind(RunService.Heartbeat, function()
	if not cfg.antiFling then return end
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end
	local v, w = hrp.AssemblyLinearVelocity, hrp.AssemblyAngularVelocity
	if v.Magnitude > FLING_SPEED or w.Magnitude > FLING_SPIN then
		-- нас флингают: стоп и назад
		for _, part in ipairs(char:GetDescendants()) do
			if part:IsA("BasePart") then
				part.AssemblyLinearVelocity = Vector3.zero
				part.AssemblyAngularVelocity = Vector3.zero
			end
		end
		if safeCf then hrp.CFrame = safeCf end
	elseif os.clock() - safeAt > 0.1 then
		-- спокойная позиция (запоминаем раз в 0.1 сек)
		safeCf, safeAt = hrp.CFrame, os.clock()
	end
end)
local function antiFlingOff()
	cfg.antiFling = false
	for part in pairs(flingSaved) do
		if part.Parent then part.CanCollide = true end
	end
	table.clear(flingSaved)
end

