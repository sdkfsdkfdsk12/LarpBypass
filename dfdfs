		if i == idx then return end
		tween(labels[idx], 0.2, { TextColor3 = SUB })
		labels[idx].Font = Enum.Font.GothamMedium
		idx = i
		tween(labels[i], 0.2, { TextColor3 = BG })
		labels[i].Font = Enum.Font.GothamBold
		tween(ind, 0.35, { Position = UDim2.new((i - 1) / n, 2, 0, 2) }, Enum.EasingDirection.Out, Enum.EasingStyle.Quint)
		indScale.Scale = 0.86
		tween(indScale, 0.4, { Scale = 1 }, Enum.EasingDirection.Out, Enum.EasingStyle.Back)
		pillStroke.Color = WHITE
		tween(pillStroke, 0.45, { Color = LINE })
		cfgSet(key, options[i])
		if not silent then task.spawn(callback, options[i]) end
	end
	cfgReg(key, function(v)
		local i = table.find(options, v)
		if i then set(i) end
	end)

	for i, opt in ipairs(options) do
		local b = new("TextButton", {
			Text = opt,
			Font = i == idx and Enum.Font.GothamBold or Enum.Font.GothamMedium,
			TextSize = 11,
