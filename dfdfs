local frames, fpsAt, lastBars = 0, os.clock(), -1
local hudT0 = os.clock()
bind(RunService.RenderStepped, function()
	frames += 1
	local now = os.clock()
	if wm.Visible then
		local t = (now - hudT0) * 0.35
		local seq = wave(t)
		for _, g in ipairs(hudGrads) do
			g.Color = seq
		end
		-- пока ни разу не нажимали - кнопка "menu" мягко пульсирует
		if not wmUsed and not wmHover then
			chipStroke.Transparency = 0.15 + 0.55 * (0.5 + 0.5 * math.cos((now - hudT0) * 4))
		end
		-- подсказка едет за вотермарком, стрелка смотрит на кнопку "menu"
		if wmScale.Scale > 0.99 then
			wmHolder.Size = UDim2.fromOffset(wm.AbsoluteSize.X, wm.AbsoluteSize.Y)
		end
		if tip.Visible then tipPlace() end
	end
	if now - fpsAt < 0.5 then return end
	local fps = math.floor(frames / (now - fpsAt) + 0.5)
	frames, fpsAt = 0, now
	if not wm.Visible then return end
	local ping = math.floor(getPing() + 0.5)
	wmFps.Text = val(fps, "fps")
	wmPing.Text = val(ping, "ms")
	wmTime.Text = '<font color="#FFFFFF">' .. os.date("%H:%M") .. "</font>"
	local lit = ping < 90 and 3 or (ping < 180 and 2 or 1)
	if lit ~= lastBars then
		lastBars = lit
		for i, b in ipairs(bars) do
			tween(b, 0.25, { BackgroundColor3 = i <= lit and WHITE or BG4 })
		end
	end
end)

