local searchWords -- слова из поиска (nil - поиск пустой)

local function itemMatches(it, s, tab)
	local key = it.key .. " " .. s.name:lower() .. " " .. tab.label.Text:lower()
	for _, w in ipairs(searchWords) do
		if not key:find(w, 1, true) then return false end
	end
	return true
end

local function relayout(tab)
	if tab.custom then return end -- своя разметка (Free anims)
	local y = PAGE_HEAD + 6
	-- поиск: остаются только подходящие строки, блоки без совпадений прячутся, всё сдвигается вверх
	if searchWords then
		for _, s in ipairs(tab.sections) do
			local ry = SEC_HEAD
			local any = false
			for _, it in ipairs(s.items) do
				local ok = itemMatches(it, s, tab)
				it.row.Visible = ok
				if ok then
					it.row.Position = UDim2.fromOffset(ROW_PAD, ry)
					ry += it.h + ROW_GAP
					any = true
				end
			end
			s.card.Visible = any
			if any then
				local h = ry + ROW_PAD - ROW_GAP
				s.card.Position = UDim2.fromOffset(EDGE, y)
				s.card.Size = UDim2.new(1, -EDGE - 6, 0, h)
				y += h + CARD_GAP
			end
		end
		tab.page.CanvasSize = UDim2.fromOffset(0, y - CARD_GAP + EDGE + 4)
		return
	end
	for _, s in ipairs(tab.sections) do
		local shown = not tab.subs or s.group == tab.sub
		local rowsOn = not s.collapsible or s.isOpen or s.open > 0.001
		for _, it in ipairs(s.items) do
			it.row.Position = UDim2.fromOffset(ROW_PAD, it.y)
			it.row.Visible = rowsOn
		end
		local h = s.height
		-- сворачиваемый блок: от шапки до полной высоты
		if s.collapsible then
			h = math.floor(SEC_HEAD + (s.height - SEC_HEAD) * s.open + 0.5)
		end
		s.card.Visible = shown
		if shown then
			s.card.Position = UDim2.fromOffset(EDGE, y)
			s.card.Size = UDim2.new(1, -EDGE - 6, 0, h)
			y += h + CARD_GAP
		end
	end
	-- снизу запас, чтобы последний блок не резался
	tab.page.CanvasSize = UDim2.fromOffset(0, y - CARD_GAP + EDGE + 4)
end

