		-- на текущей вкладке ничего - едем туда, где больше всего совпадений
		local total, best, bestN = 0, nil, 0
		for _, t in ipairs(tabs) do
			local n = countIn(t)
			total += n
			if n > bestN then best, bestN = t, n end
		end
		if current and countIn(current) == 0 and best then selectTab(best) end
		for _, t in ipairs(tabs) do relayout(t) end
		if current then current.page.CanvasPosition = Vector2.zero end
		countLbl.Visible = true
		countLbl.Text = total == 0 and "nothing" or (total .. " found")
		countLbl.TextColor3 = total == 0 and Color3.fromRGB(255, 120, 120) or SUB
	end

	bind(box:GetPropertyChangedSignal("Text"), apply)

	bind(box.Focused, function()
		tween(barStroke, 0.2, { Transparency = 0 })
		tween(ringStroke, 0.2, { Color = WHITE })
		tween(handle, 0.2, { BackgroundColor3 = WHITE })
		iconScale.Scale = 0.8
		tween(iconScale, 0.35, { Scale = 1 }, Enum.EasingDirection.Out, Enum.EasingStyle.Back)
		barScale.Scale = 0.97
		tween(barScale, 0.3, { Scale = 1 }, Enum.EasingDirection.Out, Enum.EasingStyle.Back)
		keyHint.Visible = false
	end)
	bind(box.FocusLost, function(enter)
		tween(barStroke, 0.2, { Transparency = 0.45 })
		tween(ringStroke, 0.2, { Color = SUB })
		tween(handle, 0.2, { BackgroundColor3 = SUB })
		if box.Text == "" then keyHint.Visible = UIS.KeyboardEnabled end
		if enter and searchWords and current then flash(firstRow(current)) end
	end)

	bind(UIS.InputBegan, function(input)
		if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
		local k = input.KeyCode
		-- Ctrl+F / Cmd+F: открыть меню и встать в поиск
		if k == Enum.KeyCode.F and (UIS:IsKeyDown(Enum.KeyCode.LeftControl) or UIS:IsKeyDown(Enum.KeyCode.RightControl)
			or UIS:IsKeyDown(Enum.KeyCode.LeftSuper) or UIS:IsKeyDown(Enum.KeyCode.RightSuper)) then
			if not opened then setOpen(true) end
			task.defer(function() box:CaptureFocus() end)
			return
		end
		if k == Enum.KeyCode.Escape and (box:IsFocused() or box.Text ~= "") then
			box.Text = ""
			box:ReleaseFocus()
		end
	end)
end)()

