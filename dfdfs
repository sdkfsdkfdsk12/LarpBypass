		end
	end)
	bind(UIS.InputChanged, function(input)
		if not downInput then return end
		if input.UserInputType ~= Enum.UserInputType.MouseMovement and input ~= downInput then return end
		local d = input.Position - startIn
		if not moved and d.Magnitude < 6 then return end
		moved = true
		obj.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
		-- не даём утащить за край экрана
		local ap, as, vs = obj.AbsolutePosition, obj.AbsoluteSize, gui.AbsoluteSize
		local fx = math.clamp(ap.X, 0, math.max(0, vs.X - as.X)) - ap.X
		local fy = math.clamp(ap.Y, 0, math.max(0, vs.Y - as.Y)) - ap.Y
		if fx ~= 0 or fy ~= 0 then
			obj.Position = obj.Position + UDim2.fromOffset(fx, fy)
		end
	end)
	bind(UIS.InputEnded, function(input)
		if not downInput then return end
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input ~= downInput then return end
		downInput = nil
		if onRelease then onRelease() end
		if moved then
			local p = obj.Position
			cfgData[key] = { p.X.Scale, p.X.Offset, p.Y.Scale, p.Y.Offset }
			cfgDirty, cfgAt = true, os.clock()
		elseif onClick then
			onClick()
		end
	end)
end

