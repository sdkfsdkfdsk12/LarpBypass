			Size = UDim2.fromScale(1 / n, 1),
			ZIndex = 3,
			Parent = pill,
		})
		labels[i] = b
		bind(b.MouseEnter, function() if i ~= idx then tween(b, 0.15, { TextColor3 = TEXT }) end end)
		bind(b.MouseLeave, function() if i ~= idx then tween(b, 0.15, { TextColor3 = SUB }) end end)
		bind(b.MouseButton1Click, function() set(i) end)
	end

	return {
		Set = function(opt, silent)
			local i = table.find(options, opt)
			if i then set(i, silent) end
		end,
		Get = function() return options[idx] end,
	}
end

