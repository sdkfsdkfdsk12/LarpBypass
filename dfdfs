local function hudShow(obj, sc, on)
	obj:SetAttribute("pzOn", on)
	if on then
		obj.Visible = true
		sc.Scale = 0.6
		tween(sc, 0.35, { Scale = 1 }, Enum.EasingDirection.Out, Enum.EasingStyle.Back)
	else
		local t = tween(sc, 0.18, { Scale = 0 }, Enum.EasingDirection.In)
		t.Completed:Connect(function()
			if not obj:GetAttribute("pzOn") then obj.Visible = false end
		end)
	end
end

