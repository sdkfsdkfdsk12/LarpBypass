		clear()
	end
end)()

---------------------------------------------------------------- вкладка Visuals > Models: Gun Skin (AWM на пистолет шерифа)
-- модель AWM из каталога крепится вместо пистолета, родной пистолет прячется; только у тебя на экране
;(function()
	local gs = { on = false, model = "Green", size = 100, turn = 0 }
	local MODELS = {
		Green = 17437147124,   -- AWM (зелёная, реалистичная)
		Black = 9341070001,    -- AWM (тёмная)
		Classic = 13324755498, -- Awm (классика, как в CS)
	}
	local templates, loading = {}, {}
	local cur -- { tool, model, hidden = {} }

	local function getTemplate(name)
		if templates[name] ~= nil then return templates[name] or nil end
		if loading[name] then return nil end
		loading[name] = true
		task.spawn(function()
			local ok, objs = pcall(function() return game:GetObjects("rbxassetid://" .. MODELS[name]) end)
			local root = ok and objs and objs[1]
			if root and not root:IsA("Model") then
				local m = Instance.new("Model")
				for _, o in ipairs(objs) do o.Parent = m end
				root = m
			end
			if root then
				-- модель часто сделана как Tool: в персонаже она попала бы в хотбар отдельным предметом.
				-- все Tool внутри превращаем в обычные Model
				for _, x in ipairs(root:GetDescendants()) do
					if x:IsA("BackpackItem") then
						local m = Instance.new("Model")
						m.Name = x.Name
						for _, c in ipairs(x:GetChildren()) do c.Parent = m end
						m.Parent = x.Parent
						x:Destroy()
					end
				end
				for _, x in ipairs(root:GetDescendants()) do
					if x:IsA("LuaSourceContainer") or x:IsA("Sound") or x:IsA("JointInstance") or x:IsA("WeldConstraint")
						or x:IsA("ClickDetector") or x:IsA("ProximityPrompt") or x:IsA("Humanoid") then
						x:Destroy()
					end
				end
				if not root:FindFirstChildWhichIsA("BasePart", true) then root = nil end
			end
			templates[name] = root or false
			loading[name] = nil
			if not root then notify("Gun Skin", name .. " failed to load") end
		end)
		return nil
	end

	local function clear()
		if cur then
			if cur.model then cur.model:Destroy() end
			for p in pairs(cur.hidden) do
				if p.Parent then p.LocalTransparencyModifier = 0 end
			end
		end
		cur = nil
	end

	-- оси по размерам: самая длинная - ствол, средняя - "верх"
	local AXES = { Vector3.xAxis, Vector3.yAxis, Vector3.zAxis }
	local function axesOf(size)
		local list = { { 1, size.X }, { 2, size.Y }, { 3, size.Z } }
		table.sort(list, function(a, b) return a[2] > b[2] end)
		return AXES[list[1][1]], AXES[list[2][1]], list[1][2]
	end
	local function frame(pos, look, up)
		local right = look:Cross(up).Unit
		up = right:Cross(look).Unit
		return CFrame.fromMatrix(pos, right, up, -look)
	end

	local function build(tool, handle, tmpl)
		clear()
		local m = tmpl:Clone()
		local parts = {}
		for _, x in ipairs(m:GetDescendants()) do
			if x:IsA("BasePart") then
				-- закреплены и ни с чем не взаимодействуют: двигаем сами каждый кадр
				x.Anchored, x.CanCollide, x.CanQuery, x.CanTouch, x.Massless, x.CastShadow = true, false, false, false, true, false
				table.insert(parts, x)
			end
		end
		-- размер: длина AWM ~ 4.5 studs * настройка
		local _, size = m:GetBoundingBox()
		local _, _, len = axesOf(size)
		pcall(function() m:ScaleTo(m:GetScale() * (4.5 * gs.size / 100) / math.max(len, 0.1)) end)
		local bcf, bsize = m:GetBoundingBox()
		local mLook, mUp = axesOf(bsize)
		-- ориентация модели: ствол = самая длинная ось, верх = средняя
		m.WorldPivot = frame(bcf.Position, bcf:VectorToWorldSpace(mLook), bcf:VectorToWorldSpace(mUp))
		-- то же у пистолета; Rotate переворачивает ствол / верх
		local hLook, hUp = axesOf(handle.Size)
		local fl = (gs.turn % 2 == 1) and -1 or 1
		local fu = (gs.turn >= 2) and -1 or 1
		local look = handle.CFrame:VectorToWorldSpace(hLook) * fl
		local up = handle.CFrame:VectorToWorldSpace(hUp) * fu
		-- приклад у руки: сдвигаем модель вперёд по стволу
		local _, _, blen = axesOf(bsize)
		m:PivotTo(frame(handle.Position + look * blen * 0.25, look, up))
		-- смещение каждой детали относительно пистолета - дальше просто повторяем его каждый кадр
		local offsets = {}
		for _, pt in ipairs(parts) do offsets[pt] = handle.CFrame:ToObjectSpace(pt.CFrame) end
		-- в камеру, а не в персонажа: так модель не попадает в хотбар и не мешает стрелять
		m.Name = "PZGunSkin"
		m.Parent = workspace.CurrentCamera
		cur = { tool = tool, handle = handle, model = m, offsets = offsets, hidden = {}, key = gs.model .. gs.size .. gs.turn }
	end

	bind(RunService.RenderStepped, function()
		if not gs.on then return end
		local char = player.Character
		local tool = char and char:FindFirstChild("Gun")
		local handle = tool and tool:FindFirstChild("Handle")
		if not handle then
			if cur then clear() end
			return
		end
		local key = gs.model .. gs.size .. gs.turn
		if not cur or cur.tool ~= tool or cur.key ~= key or not cur.model.Parent then
			local tmpl = getTemplate(gs.model)
			if not tmpl then return end
			build(tool, handle, tmpl)
		end
		-- AWM ровно на месте пистолета
		local hcf = handle.CFrame
		for pt, off in pairs(cur.offsets) do pt.CFrame = hcf * off end
		-- родной пистолет прячем (и его детали)
		for _, x in ipairs(tool:GetDescendants()) do
			if x:IsA("BasePart") and x.LocalTransparencyModifier < 1 then
				x.LocalTransparencyModifier = 1
				cur.hidden[x] = true
			end
		end
	end)

	local sec = addSection(tVisual, "Gun Skin", "Models")
	sec:Toggle("AWM", "sniper rifle instead of the sheriff gun (only you see it)", function(on)
		gs.on = on
		if not on then clear() end
		if on and not cfgLoading then
			showAlert("Sheriff only", "This feature only works when you are the Sheriff and hold the gun.", "Done")
		end
		notify("AWM: " .. (on and "On" or "Off"), on and "take out the gun" or "normal gun")
	end)
	sec:Select("Model", "AWM look", { "Green", "Black", "Classic" }, gs.model, function(v) gs.model = v end)
	sec:Slider("Size", 50, 200, gs.size, function(v) gs.size = v end, function(v) return v .. "%" end)
	local turnSaved = cfgData["Gun Skin/turn"]
	if type(turnSaved) == "number" then gs.turn = turnSaved end
	sec:Button("Rotate", "if the barrel points the wrong way", function()
		gs.turn = (gs.turn + 1) % 4
		cfgData["Gun Skin/turn"] = gs.turn
		cfgDirty, cfgAt = true, os.clock()
	end)

	gunSkinOff = function()
		gs.on = false
		clear()
	end
end)()

---------------------------------------------------------------- вкладка Skin Changer: коллекция скинов (видно только тебе)
-- модели скинов MM2 закрыты (copylocked) - с сайта не скачать. Поэтому собираем меши с оружия
-- других игроков: стенды в лобби (Workspace.WeaponDisplays) и ножи/пистолеты в руках в раунде.
-- Коллекция сохраняется в файл и растёт от сервера к серверу.
-- Оружие MM2: Tool > Handle [Part] > SpecialMesh (MeshId + TextureId) - их и подменяем.
;(function()
	local HttpService = game:GetService("HttpService")
	local SAVE_FILE = "peakzone_skins.json"

	local sk = {
		sel = { Knife = nil, Gun = nil }, -- ключ скина из коллекции
		listType = "Knife",
		size = 100,        -- размер скина, %
		glow = false,
		sparkles = false,
		trail = false,
		light = 60,
		enabled = true,    -- выкл - оружие обычное, коллекция продолжает собираться
	}

	---------------- коллекция

	local collection = {} -- список { key, type, mesh, tex, scale = {x,y,z}, from, t }
	local byKey = {}
	pcall(function()
		if isfile and isfile(SAVE_FILE) then
			local d = HttpService:JSONDecode(readfile(SAVE_FILE))
			for _, s in ipairs(d) do
				if type(s) == "table" and s.key and s.mesh then
					table.insert(collection, s)
					byKey[s.key] = s
				end
			end
		end
	end)

	local saveAt
	local function saveSoon() saveAt = os.clock() + 1 end

	local onNewSkin -- обновить сетку (задаётся в интерфейсе)
	local seenThisSession = {}

	local function num(id) return tostring(id):match("%d+") or tostring(id) end

	-- снять меш с детали (Part+SpecialMesh или MeshPart)
	local function readPart(part)
		if part:IsA("MeshPart") then
			if part.MeshId == "" then return end
			local ms = part.MeshSize
			local sc = ms.Magnitude > 0 and (part.Size / ms) or Vector3.one
			return part.MeshId, part.TextureID, sc
		end
		local sm = part:FindFirstChildOfClass("SpecialMesh")
		if sm and sm.MeshId ~= "" then
			return sm.MeshId, sm.TextureId, sm.Scale
		end
	end

	-- живые копии деталей (MeshPart + SurfaceAppearance): в файл их не сохранить, живут до конца сессии
	local liveClones = {}

	local function makeClone(part)
		local ok, c = pcall(function() return part:Clone() end)
		if not ok or not c then return end
		for _, d in ipairs(c:GetDescendants()) do
			if not (d:IsA("SurfaceAppearance") or d:IsA("DataModelMesh") or d:IsA("Decal")) then
				d:Destroy()
			end
		end
		c.Anchored = false
		c.CanCollide = false
		c.CanTouch = false
		c.CanQuery = false
		c.Massless = true
		c.CastShadow = false
		c.LocalTransparencyModifier = 0
		c.Name = "PZ_Skin"
		return c
	end

	local function harvest(part, ty, owner, from)
		local mesh, tex, sc = readPart(part)
		if not mesh then return end
		local key = ty .. ":" .. num(mesh) .. ":" .. num(tex)
		local hasSA = part:FindFirstChildOfClass("SurfaceAppearance") ~= nil
		if part:IsA("MeshPart") and not liveClones[key] then
			liveClones[key] = makeClone(part)
			for _, a in pairs(applied) do
				if a.key == key then a.key = nil end
			end
		end
		local col = part.Color
		local old = byKey[key]
		if old then
			-- скин из старой коллекции без цвета - дописываем
			if not old.color then
				old.color = { col.R, col.G, col.B }
				old.mat = part.Material.Name
				old.sa = hasSA
				saveSoon()
			end
			return
		end
		local s = {
			key = key,
			type = ty,
			mesh = mesh,
			tex = tex,
			color = { col.R, col.G, col.B },
			mat = part.Material.Name,
			sa = hasSA, -- текстура в SurfaceAppearance (полностью видно только с живой копией)
			scale = { sc.X, sc.Y, sc.Z },
			from = owner and owner.DisplayName or "?",
			src = from or "display", -- стенд на спине или оружие в руке (у них разный масштаб)
			t = os.time(),
		}
		table.insert(collection, s)
		byKey[key] = s
		seenThisSession[key] = true
		saveSoon()
		if onNewSkin then onNewSkin(s) end
	end

	-- чей стенд: по креплению к персонажу
	local function ownerOf(part)
		for _, c in ipairs(part:GetChildren()) do
			if c:IsA("RigidConstraint") or c:IsA("Weld") or c:IsA("WeldConstraint") then
				for _, prop in ipairs({ "Attachment0", "Attachment1", "Part0", "Part1" }) do
					local ok, v = pcall(function() return c[prop] end)
					if ok and v and not v:IsDescendantOf(part) then
						local model = v:FindFirstAncestorOfClass("Model")
						local plr = model and Players:GetPlayerFromCharacter(model)
						if plr then return plr end
					end
				end
			end
		end
	end

	local function scanServer()
		local wd = workspace:FindFirstChild("WeaponDisplays")
		if wd then
			for _, d in ipairs(wd:GetChildren()) do
				if d:IsA("BasePart") then
					local ty = d.Name:find("Knife") and "Knife" or (d.Name:find("Gun") and "Gun" or nil)
					if ty then
						local owner = ownerOf(d)
						if owner ~= player then harvest(d, ty, owner, "display") end
					end
				end
			end
		end
		-- в раунде: оружие в руках у других
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= player and plr.Character then
				for _, ty in ipairs({ "Knife", "Gun" }) do
					local tool = plr.Character:FindFirstChild(ty)
					local handle = tool and tool:FindFirstChild("Handle")
					if handle and handle:IsA("BasePart") then harvest(handle, ty, plr, "tool") end
				end
			end
		end
	end

	---------------- надеваем на своё оружие
	-- цели: ручка ножа/пистолета в раунде и свои стенды на спине в лобби (WeaponDisplays)

	local applied = {} -- деталь -> { mesh, orig, overlay, key, size, fx }

	local function restore(part)
		local a = applied[part]
		if not a then return end
		pcall(function()
			if a.mesh and a.orig then
				a.mesh.MeshId = a.orig.MeshId
				a.mesh.TextureId = a.orig.TextureId
				a.mesh.Scale = a.orig.Scale
			end
			if a.origColor then
				part.Color = a.origColor
				part.Material = a.origMat
			end
			if a.overlay then a.overlay:Destroy() end
			part.LocalTransparencyModifier = 0
		end)
		for _, f in ipairs(a.fx) do f:Destroy() end
		applied[part] = nil
	end

	local function restoreAll()
		for part in pairs(applied) do restore(part) end
	end

	local function tipAttachments(handle)
		local s = handle.Size
		local axis = (s.X >= s.Y and s.X >= s.Z) and Vector3.xAxis or (s.Y >= s.Z and Vector3.yAxis or Vector3.zAxis)
		local len = (s * axis).Magnitude / 2
		local a0 = new("Attachment", { Name = "PZ_Trail0", Position = axis * len * 0.9, Parent = handle })
		local a1 = new("Attachment", { Name = "PZ_Trail1", Position = -axis * len * 0.2, Parent = handle })
		return a0, a1
	end

	local function addFx(a, handle)
		for _, f in ipairs(a.fx) do f:Destroy() end
		a.fx = {}
		local col = WHITE
		if sk.glow then
			table.insert(a.fx, new("PointLight", { Name = "PZ_Glow", Color = col, Brightness = sk.light / 25, Range = 9, Shadows = false, Parent = handle }))
		end
		if sk.sparkles then
			table.insert(a.fx, new("ParticleEmitter", {
				Name = "PZ_Sparkles",
				Texture = "rbxasset://textures/particles/sparkles_main.dds",
				LightEmission = 1,
				Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.25), NumberSequenceKeypoint.new(1, 0) }),
				Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) }),
				Lifetime = NumberRange.new(0.4, 0.8),
				Rate = 14,
				Speed = NumberRange.new(0.5, 1.5),
				SpreadAngle = Vector2.new(180, 180),
				Parent = handle,
			}))
		end
		if sk.trail then
			local a0, a1 = tipAttachments(handle)
			table.insert(a.fx, a0)
			table.insert(a.fx, a1)
			table.insert(a.fx, new("Trail", {
				Name = "PZ_Trail",
				Attachment0 = a0,
				Attachment1 = a1,
				LightEmission = 1,
				Lifetime = 0.22,
				MinLength = 0.05,
				FaceCamera = true,
				Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.25), NumberSequenceKeypoint.new(1, 1) }),
				WidthScale = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0) }),
				Parent = handle,
			}))
		end
	end

	-- K = масштаб в руке / масштаб на стенде (меряем на своём родном оружии, запоминаем)
	local ref = { tool = nil, display = nil }
	local K = 1
	local function recalcK()
		if ref.tool and ref.display and ref.display > 0 then
			K = ref.tool / ref.display
			cfgSet("Skin Changer/K", K)
		end
	end
	cfgReg("Skin Changer/K", function(v) if type(v) == "number" and v > 0 then K = v end end)

	-- родной размер детали (для калибровки)
	local function effScale(part)
		if part:IsA("MeshPart") then
			local ms = part.MeshSize
			return ms.Magnitude > 0 and (part.Size / ms).Magnitude or nil
		end
		local sm = part:FindFirstChildOfClass("SpecialMesh")
		return sm and sm.Scale.Magnitude or nil
	end

	local function targetScale(s, kind)
		local v = Vector3.new(s.scale[1], s.scale[2], s.scale[3])
		local from = s.src or "display"
		if kind == "tool" and from == "display" then
			v *= K
		elseif kind == "display" and from == "tool" then
			v /= K
		end
		return v * (sk.size / 100)
	end

	-- надеть скин типа ty на деталь (ручку или стенд); withFx - эффекты только на оружие в руке
	local function applyPart(part, ty, withFx)
		local kind = withFx and "tool" or "display"
		-- замер родного размера, пока скин ещё не надет
		if not applied[part] then
			local e = effScale(part)
			if e and e > 0 and ref[kind] ~= e then
				ref[kind] = e
				recalcK()
			end
		end
		local s = byKey[sk.sel[ty]]
		if not s then
			restore(part)
			return
		end
		local a = applied[part]
		if a and a.key == s.key and a.size == sk.size then
			-- игра могла вернуть свой меш - ставим обратно
			if a.mesh and a.mesh.MeshId ~= s.mesh then a.key = nil else
				if a.overlay then part.LocalTransparencyModifier = 1 end
				return
			end
		end
		if not a then
			a = { fx = {}, origColor = part.Color, origMat = part.Material }
			local sm = part:FindFirstChildOfClass("SpecialMesh")
			if sm and not part:IsA("MeshPart") then
				a.mesh = sm
				a.orig = { MeshId = sm.MeshId, TextureId = sm.TextureId, Scale = sm.Scale }
			end
			applied[part] = a
		end
		a.key, a.size = s.key, sk.size

		local live = liveClones[s.key]
		if live then
			-- есть живая копия (со всеми текстурами) - приваряем её, своё прячем
			if a.mesh and a.orig then
				a.mesh.MeshId = a.orig.MeshId
				a.mesh.TextureId = a.orig.TextureId
				a.mesh.Scale = a.orig.Scale
			end
			if a.overlay then a.overlay:Destroy() end
			local f = targetScale({ scale = { 1, 1, 1 }, src = s.src }, kind).X
			local p = live:Clone()
			p.Size = live.Size * f
			p.CFrame = part.CFrame
			p.Parent = part
			new("WeldConstraint", { Part0 = part, Part1 = p, Parent = p })
			a.overlay = p
			part.LocalTransparencyModifier = 1
			a.liveUsed = true
		elseif a.mesh then
			if a.overlay then
				a.overlay:Destroy()
				a.overlay = nil
				part.LocalTransparencyModifier = 0
			end
			a.mesh.MeshId = s.mesh
			a.mesh.TextureId = s.tex
			a.mesh.Scale = targetScale(s, kind)
			-- у скинов без текстуры цвет задаёт сама деталь
			if s.color then
				part.Color = Color3.new(s.color[1], s.color[2], s.color[3])
				pcall(function() part.Material = Enum.Material[s.mat] end)
			end
		else
			-- MeshPart (меш не поменять): прячем его у себя и приваряем копию со скином
			if a.overlay then a.overlay:Destroy() end
			local p = new("Part", {
				Name = "PZ_Skin",
				Size = Vector3.one * 0.2,
				Transparency = 0,
				CanCollide = false,
				CanTouch = false,
				CanQuery = false,
				Massless = true,
				Anchored = false,
				CFrame = part.CFrame,
				Parent = part,
			})
			new("SpecialMesh", { MeshType = Enum.MeshType.FileMesh, MeshId = s.mesh, TextureId = s.tex, Scale = targetScale(s, kind), Parent = p })
			if s.color then
				p.Color = Color3.new(s.color[1], s.color[2], s.color[3])
				pcall(function() p.Material = Enum.Material[s.mat] end)
			end
			new("WeldConstraint", { Part0 = part, Part1 = p, Parent = p })
			a.overlay = p
			part.LocalTransparencyModifier = 1
		end
		if withFx then addFx(a, part) end
	end

