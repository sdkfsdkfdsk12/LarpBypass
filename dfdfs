---------------------------------------------------------------- вкладки

local tabs = {}
local current

local function selectTab(tab)
	if current == tab then return end
	local old = current
	current = tab

	-- все остальные страницы сразу прячем - ничего не наслаивается
	for _, t in ipairs(tabs) do
		if t ~= tab then
			t.page.Visible = false
		end
	end

	local y = tab.y
	if old then
		tween(highlight, 0.3, { Position = UDim2.fromOffset(8, y) }, Enum.EasingDirection.Out, Enum.EasingStyle.Quint)
	else
		highlight.Position = UDim2.fromOffset(8, y)
	end
	trace()

	if old then
		tween(old.label, 0.2, { TextColor3 = SUB })
		old.label.Font = Enum.Font.GothamMedium
		old.icon.color(SUB)
		old.chev(false)
	end

	tween(tab.label, 0.2, { TextColor3 = WHITE })
	tab.label.Font = Enum.Font.GothamBold
	tab.icon.color(WHITE)
	tab.icon.pop()
	tab.chev(true)

	-- новая страница выезжает снизу, шторка плавно растворяется
	tab.page.CanvasPosition = Vector2.zero
	tab.page.Position = UDim2.fromOffset(0, 14)
	tab.page.Visible = true
	tween(tab.page, 0.35, { Position = UDim2.fromOffset(0, 0) }, Enum.EasingDirection.Out, Enum.EasingStyle.Quint)

	if coverTween then coverTween:Cancel() end
	cover.BackgroundTransparency = 0
	coverTween = tween(cover, 0.3, { BackgroundTransparency = 1 })
end

