local activeSlider -- чтобы не таскалось окно и несколько слайдеров сразу

-- fmt (необязательно): как показывать значение, например function(v) return v .. "%" end
function Section:Slider(name, min, max, default, callback, fmt)
	fmt = fmt or tostring
	local key = cfgKey(self, name)
	local row, title = self:_row(name, nil, 44)
	title.Position = UDim2.fromOffset(12, 7)

	-- ширина окошка под самое длинное значение
	local boxW = 40
	for _, v in ipairs({ min, max, default }) do
		boxW = math.max(boxW, TextService:GetTextSize(fmt(v), 10, Enum.Font.GothamBold, Vector2.new(200, 20)).X + 16)
	end
	title.Size = UDim2.new(1, -(boxW + 30), 0, 16)

	local valueBox = new("TextLabel", {
		Text = fmt(default),
		Font = Enum.Font.GothamBold,
		TextSize = 10,
		TextColor3 = TEXT,
		BackgroundColor3 = BG,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -10, 0, 6),
		Size = UDim2.fromOffset(boxW, 18),
		Parent = row,
	})
	round(valueBox, 6)
	local valueStroke = outline(valueBox)

	local bar = new("Frame", {
		Position = UDim2.new(0, 12, 0, 31),
		Size = UDim2.new(1, -24, 0, 5),
		BackgroundColor3 = BG,
		BorderSizePixel = 0,
		Parent = row,
	})
	circle(bar)
	outline(bar)

	local KNOB = 12
	local rel0 = (default - min) / (max - min)
	local fill = new("Frame", {
		Size = UDim2.new(rel0, KNOB / 2 - KNOB * rel0, 1, 0),
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
		Parent = bar,
	})
	circle(fill)
	new("UIGradient", { Color = ColorSequence.new(Color3.fromRGB(95, 95, 95), WHITE), Parent = fill })

	-- кружок ездит только внутри полоски (на 0 и на максимуме не вылезает за край)
	local track = new("Frame", {
		Position = UDim2.fromOffset(KNOB / 2, 0),
		Size = UDim2.new(1, -KNOB, 1, 0),
		BackgroundTransparency = 1,
		ZIndex = 2,
		Parent = bar,
	})

	local knob = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(rel0, 0.5),
		Size = UDim2.fromOffset(KNOB, KNOB),
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
		ZIndex = 2,
		Parent = track,
	})
	circle(knob)
	-- тёмное кольцо вокруг - кружок как будто "вырезан" над полоской
	new("UIStroke", { Color = BG3, Thickness = 2, Parent = knob })
	local knobScale = new("UIScale", { Parent = knob })

	local hit = new("TextButton", {
		Text = "",
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 0, 0, 22),
		Size = UDim2.new(1, 0, 0, 22),
		ZIndex = 3,
		Parent = row,
	})

	local last = default
	local dragging = false

	local function show(value, t)
		local r = (value - min) / (max - min)
		-- заливка доходит ровно до центра кружка
		tween(knob, t, { Position = UDim2.fromScale(r, 0.5) }, Enum.EasingDirection.Out, Enum.EasingStyle.Quint)
		tween(fill, t, { Size = UDim2.new(r, KNOB / 2 - KNOB * r, 1, 0) }, Enum.EasingDirection.Out, Enum.EasingStyle.Quint)
		valueBox.Text = fmt(value)
	end

	local function set(x)
		local w = math.max(track.AbsoluteSize.X, 1)
		local rel = math.clamp((x - track.AbsolutePosition.X) / w, 0, 1)
		local value = math.floor(min + (max - min) * rel + 0.5)
		show(value, 0.08)
		if value ~= last then
			last = value
			cfgSet(key, value)
			task.spawn(callback, value)
		end
	end

	bind(row.MouseEnter, function() if not dragging then tween(knobScale, 0.2, { Scale = 1.15 }) end end)
	bind(row.MouseLeave, function() if not dragging then tween(knobScale, 0.2, { Scale = 1 }) end end)

	bind(hit.InputBegan, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			activeSlider = set
			dragging = true
			tween(knobScale, 0.2, { Scale = 1.35 }, Enum.EasingDirection.Out, Enum.EasingStyle.Back)
			tween(valueStroke, 0.15, { Color = WHITE })
			tween(valueBox, 0.15, { TextColor3 = WHITE })
			set(input.Position.X)
		end
	end)
	bind(UIS.InputEnded, function(input)
		if not dragging then return end
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
			tween(knobScale, 0.25, { Scale = 1 }, Enum.EasingDirection.Out, Enum.EasingStyle.Quint)
			tween(valueStroke, 0.3, { Color = LINE })
			tween(valueBox, 0.3, { TextColor3 = TEXT })
		end
	end)

	local function setValue(v, silent)
		v = math.clamp(v, min, max)
		show(v, 0.3)
		if v ~= last then
			last = v
			cfgSet(key, v)
			if not silent then task.spawn(callback, v) end
		end
	end
	cfgReg(key, function(v)
		if type(v) == "number" then setValue(v) end
	end)

	return {
		Set = setValue,
		Get = function() return last end,
	}
end

