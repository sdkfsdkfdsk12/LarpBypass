	-- известные паки: id анимаций прямо, без загрузки
	local KNOWN = {}
	for _, cat in ipairs(PACKS) do
		for _, p in ipairs(cat[2]) do
			KNOWN[norm(p[1])] = p
		end
	end
	local function knownSlots(p)
		local function one(v)
			return (v and v ~= 0) and { "rbxassetid://" .. idStr(v) } or nil
		end
		local idle2 = (p[3] and p[3] ~= 0) and p[3] or p[2]
		return {
			idle = { "rbxassetid://" .. idStr(p[2]), "rbxassetid://" .. idStr(idle2) },
			walk = one(p[4]), run = one(p[5]), jump = one(p[6]), fall = one(p[7]),
			climb = one(p[8]), swim = one(p[9]), swimidle = one(p[10]),
		}
	end

	-- ассеты бандла из ответа каталога (AssetType строкой или по имени)
	local function assetsFromItems(items)
		local a = { 0, 0, 0, 0, 0, 0, 0 }
		for _, it in ipairs(items or {}) do
			local k = AT_INDEX[tostring(it.AssetType or "")]
			if not k and it.Name then
				local n = it.Name:lower()
				for i, s in ipairs(SLOT_NAMES) do
					if n:find(s, 1, true) then k = i break end
				end
			end
			if k and (it.Type == nil or it.Type == "Asset") then
				a[k] = it.Id
			end
		end
		return a
	end

	local bundles, bundleById = {}, {}
	local function addBundle(id, name, assets, isNew, at)
		local b = bundleById[id]
		if b then
			if isNew then b.new = true end
			return b, false
		end
		b = { id = id, name = name, assets = assets, new = isNew, kind = "b" }
		bundleById[id] = b
		if at then table.insert(bundles, at, b) else table.insert(bundles, b) end
		return b, true
	end
