	local adorned = {} -- площадка -> { gui, ... }, собирается раз за тик
	local function scanAdorned()
		table.clear(adorned)
		local pg = player:FindFirstChildOfClass("PlayerGui")
		if not pg then return end
		for _, g in ipairs(pg:GetDescendants()) do
			if (g:IsA("SurfaceGui") or g:IsA("BillboardGui")) and g.Adornee then
				local list = adorned[g.Adornee] or {}
				adorned[g.Adornee] = list
				table.insert(list, g)
			end
		end
